# Build output
dist/
.output/

# Dependencies
node_modules/

# Environment
.env
.env.local
.env.*.local
# wrangler / Pages Functions local secrets (COINGECKO_API_KEY, GITHUB_OAUTH_*)
.dev.vars
.dev.vars.*

# Astro
.astro/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Temp
tmp/
temp/

# Python
__pycache__/
*.pyc

# Test fixtures written by scripts/test-outbound-checker.mjs on every run.
# They are regenerated each time, so committing them (or leaving them
# untracked) just keeps the working tree permanently dirty.
/_outbound-fixture.json
/_outbound-known.json

# local build artifacts that are never deployed
/_dist_verify/
/_local_stale/
/_build*.log
/_b.log

# Recovery scaffolding. The sandbox has twice deleted directories out from under
# git (the whole of src/ once, and .git/refs/ + .git/objects/pack/ another time),
# so a .git snapshot is kept around after any repair. Never commit these.
/.git-backup-*/
/_refs_broken/
/_restore-scratch/

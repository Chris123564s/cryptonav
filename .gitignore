dist/
.output/

# Dependencies
node_modules/

# Environment
.env
.env.local
.env.*.local
# wrangler / Pages Functions local secrets (COINGECKO_API_KEY, GITHUB_OAUTH_*)
.dev.vars
.dev.vars.*

# Astro
.astro/


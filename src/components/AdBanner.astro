---
import { getAd } from '../utils/data';
import type { AdSlot } from '../types';

interface Props {
  slot: AdSlot;
  format?: 'banner' | 'sidebar' | 'inline';
  className?: string;
}

const { slot, format = 'banner', className = '' } = Astro.props;
const ad = getAd(slot);

const sizeClasses: Record<string, string> = {
  banner: 'w-full h-[120px] md:h-[180px]',
  sidebar: 'w-full h-[250px]',
  inline: 'w-full h-[120px]',
};

// 渐变样式映射
const gradients: Record<string, string> = {
  'btc': 'from-orange-500 to-amber-600',
  'eth': 'from-indigo-500 to-purple-600',
  'exchange': 'from-yellow-500 to-amber-600',
  'defi': 'from-emerald-500 to-teal-600',
  'wallet': 'from-blue-500 to-cyan-600',
  'nft': 'from-pink-500 to-rose-600',
  'default': 'from-brand-600 to-accent-500',
};
const gradientClass = gradients[ad?.gradient || 'default'] || gradients['default'];
---

{ad ? (
  <a
    href={ad.link}
    class={`ad-container ${sizeClasses[format]} ${className}`}
    target={ad.link.startsWith('/') ? '' : '_blank'}
    rel={ad.link.startsWith('/') ? '' : 'sponsored noopener'}
    data-ad-id={ad.id}
  >
    {ad.image ? (
      <img src={ad.image} alt={ad.title} class="w-full h-full object-cover" loading="lazy" />
    ) : (
      <div class={`flex flex-col items-center justify-center text-center px-4 h-full bg-gradient-to-br ${gradientClass} text-white`}>
        <p class="text-base md:text-lg font-bold">{ad.title}</p>
        {ad.subtitle && <p class="text-xs md:text-sm text-white/90 mt-1 max-w-md">{ad.subtitle}</p>}
        {!ad.subtitle && <p class="text-xs text-white/80 mt-1">Contact: advertise@cryptonav.com</p>}
      </div>
    )}
    <span class="ad-label">Ad</span>
  </a>
) : (
  <div class={`ad-container ${sizeClasses[format]} ${className}`}>
    <div class="flex flex-col items-center justify-center text-center px-4">
      <p class="text-sm font-medium text-surface-400 dark:text-surface-500">Advertising Space Available</p>
      <a href="/advertise" class="text-xs text-brand-500 hover:text-brand-600 mt-1">Learn More</a>
    </div>
    <span class="ad-label">Ad</span>
  </div>
)}

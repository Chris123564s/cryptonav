---
import { categories, getProjectsByParentCategory } from '../utils/data';
import type { Category } from '../types';

// Category icon SVGs
const icons: Record<string, string> = {
  exchange: '<path d="M3 13h18M3 13l4-4m-4 4l4 4m14-4l-4-4m4 4l-4 4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  wallet: '<path d="M21 12V7H5a2 2 0 010-4h14v4M5 3a2 2 0 100 4m0 0a2 2 0 000 4h16v5a2 2 0 01-2 2H5a2 2 0 01-2-2V7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  chart: '<path d="M9 17v-6m6 6V5m-9 12h12M3 21h18M3 3v18" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  defi: '<path d="M12 2v4m0 12v4m-7-7H1m22 0h-4m-3.5-5.5L18 8m-9 8l-3.5 3.5M6 6l2 2m8 8l2 2M6 18l2-2" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  nft: '<path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  infra: '<path d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  shield: '<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  media: '<path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  tool: '<path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
};
---

<section class="mb-12">
  <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100 mb-4">Browse by Category</h2>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
    {categories.map(cat => {
      const count = getProjectsByParentCategory(cat.id).length;
      return (
        <a href={`/category/${cat.slug}`} class="category-card block">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-brand-50 dark:bg-brand-900/30 flex items-center justify-center text-brand-600 dark:text-brand-400 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[cat.icon] || icons.tool} />
            </div>
            <div>
              <h3 class="font-semibold text-sm text-surface-800 dark:text-surface-100">{cat.name}</h3>
              <p class="text-xs text-surface-400">{count} projects</p>
            </div>
          </div>
          <p class="text-xs text-surface-500 dark:text-surface-400 line-clamp-1">{cat.description}</p>
          <div class="flex flex-wrap gap-1 mt-2">
            {cat.subcategories.slice(0, 3).map(sub => (
              <span class="inline-block text-[10px] text-surface-400 bg-surface-100 dark:bg-surface-700 px-1.5 py-0.5 rounded">{sub.name}</span>
            ))}
            {cat.subcategories.length > 3 && (
              <span class="inline-block text-[10px] text-surface-400">+{cat.subcategories.length - 3}</span>
            )}
          </div>
        </a>
      );
    })}
  </div>
</section>

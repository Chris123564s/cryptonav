---
import { tickerCoins, formatPrice } from '../utils/data';

// CoinGecko 的 coin id 列表（用于实时拉取）
const coinIds = tickerCoins.map(c => c.id).join(',');
---

{tickerCoins.length > 0 && (
  <div class="bg-white dark:bg-surface-800 border-y border-surface-200 dark:border-surface-700 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 flex items-center gap-3">
      <span class="shrink-0 text-xs font-bold text-surface-500 dark:text-surface-400 py-2 flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
        Live Prices
      </span>
      <div class="overflow-hidden flex-1">
        <div class="ticker-track gap-6 py-2" id="ticker-track">
          {[...tickerCoins, ...tickerCoins].map(coin => (
            <a
              href={`https://www.coingecko.com/en/coins/${coin.id}`}
              target="_blank"
              rel="noopener"
              class="shrink-0 flex items-center gap-2 text-xs hover:bg-surface-50 dark:hover:bg-surface-700 px-3 py-1 rounded-lg transition-colors"
              data-coin-id={coin.id}
            >
              <img src={coin.image} alt={coin.name} class="w-4 h-4 rounded-full" loading="lazy" />
              <span class="font-medium text-surface-600 dark:text-surface-300">{coin.symbol}</span>
              <span class="font-mono text-surface-500 dark:text-surface-400 ticker-price">{formatPrice(coin.currentPrice)}</span>
              <span class={`font-mono ticker-change ${coin.priceChangePercentage24h >= 0 ? 'text-green-500' : 'text-red-500'}`}>
                {coin.priceChangePercentage24h >= 0 ? '+' : ''}{coin.priceChangePercentage24h.toFixed(2)}%
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
)}

<script is:inline define:vars={{ coinIds }}>
  const TICKER_IDS = coinIds;
  const UPDATE_INTERVAL = 60000; // 60 秒
  // Production prefers the edge-cached /api/cg proxy (see functions/api/cg).
  // `astro dev` has no Pages Functions, so use the direct API on localhost.
  const CG_DIRECT = 'https://api.coingecko.com/api/v3';
  const CG = (location.hostname === 'localhost' || location.hostname === '127.0.0.1')
    ? CG_DIRECT
    : '/api/cg';
  // CoinGecko rate-limits by IP and Cloudflare's shared egress IPs are often
  // throttled, so once the edge fails we stop trying it for this page's life
  // instead of wasting a round trip on every poll.
  var cgEdgeDown = false;
  function cgGet(path) {
    if (cgEdgeDown || CG === CG_DIRECT) return fetch(CG_DIRECT + path);
    return fetch(CG + path).then(function (res) {
      if (res.status === 429 || res.status >= 500) {
        cgEdgeDown = true;
        return fetch(CG_DIRECT + path);
      }
      return res;
    }, function () {
      cgEdgeDown = true;
      return fetch(CG_DIRECT + path);
    });
  }

  async function fetchPrices() {
    if (!TICKER_IDS) return;
    try {
      const res = await cgGet(`/simple/price?ids=${TICKER_IDS}&vs_currencies=usd&include_24hr_change=true`);
      if (!res.ok) return;
      const data = await res.json();

      // 更新所有 ticker 元素（两份循环副本都要更新）
      const items = document.querySelectorAll('#ticker-track [data-coin-id]');
      items.forEach(el => {
        const id = el.getAttribute('data-coin-id');
        const priceEl = el.querySelector('.ticker-price');
        const changeEl = el.querySelector('.ticker-change');
        if (data[id] && priceEl) {
          const price = data[id].usd;
          const change = data[id].usd_24h_change;
          priceEl.textContent = price >= 1
            ? `$${price.toLocaleString('en-US', { maximumFractionDigits: 2 })}`
            : `$${price.toFixed(4)}`;
          if (changeEl && change !== undefined) {
            const sign = change >= 0 ? '+' : '';
            changeEl.textContent = `${sign}${change.toFixed(2)}%`;
            changeEl.className = `font-mono ticker-change ${change >= 0 ? 'text-green-500' : 'text-red-500'}`;
          }
        }
      });
    } catch (e) {
      // 网络错误或限流时保留静态兜底数据
    }
  }

  // 页面加载后拉取一次，之后定时刷新
  document.addEventListener('DOMContentLoaded', () => {
    fetchPrices();
    setInterval(fetchPrices, UPDATE_INTERVAL);

    // 点击 ticker 中的币种 -> 通知走势图切换（与 MarketChart 联动）
    const tickerEls = document.querySelectorAll('#ticker-track [data-coin-id]');
    tickerEls.forEach(el => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const id = el.getAttribute('data-coin-id');
        if (id) {
          document.dispatchEvent(new CustomEvent('coin-selected', { detail: { id } }));
        }
      });
    });
  });
</script>

---
// 实时新土狗币雷达（客户端拉 CoinGecko trending + 价格补涨跌幅）
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
  <div class="flex items-center justify-between mb-3">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
      <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100">Trending New Tokens</h2>
    </div>
    <span class="text-xs text-surface-400">Live · CoinGecko</span>
  </div>

  <div class="bg-white dark:bg-surface-800 rounded-2xl border border-surface-200 dark:border-surface-700 p-4 shadow-sm">
    <div id="radar-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <div class="col-span-full text-center text-sm text-surface-400 py-8">Loading trending tokens…</div>
    </div>
    <p class="text-xs text-surface-400 mt-3 text-center">
      Data from CoinGecko trending. Not investment advice — always DYOR.
    </p>
  </div>
</section>

<script>
  import { CG_BASE } from '../utils/coingecko';

  const REFRESH = 60000; // 60s

  function fmtPrice(v: number): string {
    if (v >= 1) return `$${v.toLocaleString('en-US', { maximumFractionDigits: 2 })}`;
    if (v >= 0.01) return `$${v.toFixed(4)}`;
    return `$${v.toPrecision(3)}`;
  }

  function tokenCard(c: any): string {
    const up = c.change24h >= 0;
    const color = up ? 'text-green-500' : 'text-red-500';
    const sign = up ? '+' : '';
    const sym = (c.symbol || '?').toUpperCase();
    const initial = (c.name || sym || '?').charAt(0).toUpperCase();
    return `
      <a href="${c.link}" target="_blank" rel="noopener"
         class="flex items-center gap-3 p-3 rounded-xl border border-surface-200 dark:border-surface-700 hover:border-brand-400 transition-colors">
        <img src="${c.thumb}" alt="${c.name}" class="w-8 h-8 rounded-full object-cover"
             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" loading="lazy" />
        <div class="w-8 h-8 rounded-full bg-brand-100 dark:bg-brand-900 items-center justify-center text-sm font-bold text-brand-600 dark:text-brand-400" style="display:none">${initial}</div>
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <span class="text-sm font-semibold text-surface-800 dark:text-surface-100 truncate">${c.name}</span>
            <span class="text-xs text-surface-400">${sym}</span>
          </div>
          <div class="text-xs font-mono text-surface-500 dark:text-surface-400">${c.price ? fmtPrice(c.price) : '—'}</div>
        </div>
        <div class="text-right shrink-0">
          <div class="text-xs font-mono ${color}">${sign}${c.change24h ? c.change24h.toFixed(2) : '0.00'}%</div>
          <div class="text-[10px] text-surface-400">${c.rank ? '#' + c.rank : 'new'}</div>
        </div>
      </a>
    `;
  }

  async function loadRadar() {
    const grid = document.getElementById('radar-grid');
    if (!grid) return;
    try {
      const tRes = await fetch(`${CG_BASE}/search/trending`);
      if (!tRes.ok) throw new Error('trending fail');
      const tJson = await tRes.json();
      const coins = (tJson.coins || []).map((x: any) => x.item);

      // 用 simple/price 补实时价 + 24h 涨跌幅
      const ids = coins.map((c: any) => c.id).join(',');
      let priceMap: Record<string, any> = {};
      if (ids) {
        try {
          const pRes = await fetch(`${CG_BASE}/simple/price?ids=${ids}&vs_currencies=usd&include_24hr_change=true`);
          if (pRes.ok) priceMap = await pRes.json();
        } catch (e) { /* 忽略，用 trending 自带数据 */ }
      }

      const list = coins.map((c: any) => {
        const pd = priceMap[c.id];
        const d = c.data || {};
        return {
          id: c.id,
          name: c.name,
          symbol: c.symbol,
          thumb: c.thumb || c.small,
          rank: c.market_cap_rank,
          price: pd ? pd.usd : (d.price || null),
          change24h: pd ? pd.usd_24h_change : (d.price_change_percentage_24h?.usd ?? 0),
          link: `https://www.coingecko.com/en/coins/${c.id}`,
        };
      });

      grid.innerHTML = list.length
        ? list.map(tokenCard).join('')
        : '<div class="col-span-full text-center text-sm text-surface-400 py-8">No tokens found.</div>';
    } catch (e) {
      grid.innerHTML = '<div class="col-span-full text-center text-sm text-surface-400 py-8">Trending data temporarily unavailable. Please retry later.</div>';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadRadar();
    setInterval(loadRadar, REFRESH);
  });
</script>

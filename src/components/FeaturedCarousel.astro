---
import { getFeaturedProjects, getReferralUrl } from '../utils/data';
import { featured } from '../utils/data';

const featuredProjects = getFeaturedProjects();
const reasons = featured.reduce((acc, f) => {
  acc[f.projectId] = f.reason;
  return acc;
}, {} as Record<string, string>);
---

{featuredProjects.length > 0 && (
  <section class="mb-12">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100 flex items-center gap-2">
        <svg class="w-5 h-5 text-accent-500" fill="currentColor" viewBox="0 0 20 20"><path d="M10 1l2.5 5.5L18 7l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5L10 1z"/></svg>
        Featured Picks
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {featuredProjects.map(project => (
        <div class="project-card group">
          <a href={getReferralUrl(project)} target="_blank" rel="noopener noreferrer" class="block">
            <div class="flex items-center gap-3 mb-3">
              {project.logo ? (
                <img src={project.logo} alt={project.name} class="w-12 h-12 rounded-xl object-cover" loading="lazy" />
              ) : (
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-100 to-brand-200 dark:from-brand-900 dark:to-brand-800 flex items-center justify-center text-lg font-bold text-brand-600 dark:text-brand-400">
                  {project.name.charAt(0)}
                </div>
              )}
              <div>
                <h3 class="font-bold text-surface-800 dark:text-surface-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">{project.name}</h3>
                {project.symbol && <span class="text-xs font-mono text-surface-400">{project.symbol}</span>}
              </div>
              {project.sponsored && <span class="sponsored-badge ml-auto">Sponsored</span>}
            </div>
            <p class="text-sm text-surface-500 dark:text-surface-400 line-clamp-2 mb-2">{project.description}</p>
            <p class="text-xs text-brand-500 dark:text-brand-400 flex items-center gap-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
              {reasons[project.id]}
            </p>
          </a>
        </div>
      ))}
    </div>
  </section>
)}

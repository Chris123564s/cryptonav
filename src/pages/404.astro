---
import Layout from '../layouts/Layout.astro';
import { categories } from '../utils/data';
---

<Layout
  title="Page Not Found — CryptoNav"
  description="The page you were looking for has moved or never existed. Browse the CryptoNav directory of verified crypto exchanges, wallets, DeFi protocols and tools."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <p class="text-6xl font-extrabold text-brand-600 dark:text-brand-400">404</p>
    <h1 class="text-2xl font-bold text-surface-800 dark:text-surface-100 mt-4">Page not found</h1>
    <p class="text-sm text-surface-500 dark:text-surface-400 mt-2 max-w-md mx-auto">
      The page you're looking for doesn't exist or may have moved. Let's get you back on track.
    </p>

    <div class="flex items-center justify-center gap-3 mt-8">
      <a href="/" class="inline-flex items-center gap-1 px-4 py-2 rounded-lg bg-brand-600 text-white text-sm font-medium hover:bg-brand-700 transition-colors">
        Back to Home
      </a>
      <a href="/submit" class="inline-flex items-center gap-1 px-4 py-2 rounded-lg border border-surface-200 dark:border-surface-700 text-sm font-medium text-surface-600 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors">
        Submit a Project
      </a>
    </div>

    <div class="mt-12">
      <p class="text-xs text-surface-400 mb-3">Or browse a category</p>
      <div class="flex flex-wrap justify-center gap-2">
        {categories.map(cat => (
          <a href={`/category/${cat.slug}`} class="px-3 py-1.5 text-xs rounded-lg bg-surface-100 dark:bg-surface-800 text-surface-600 dark:text-surface-300 hover:bg-surface-200 dark:hover:bg-surface-700 transition-colors">
            {cat.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

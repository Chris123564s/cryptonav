---
import Layout from '../layouts/Layout.astro';
---

<Layout title="提交收录 - CryptoNav">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-2xl font-bold text-surface-800 dark:text-surface-100 mb-2">提交收录</h1>
    <p class="text-sm text-surface-500 dark:text-surface-400 mb-8">发现了一个好项目？提交给我们，经审核后上线</p>

    <form class="space-y-5" id="submit-form">
      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">项目名称 *</label>
        <input type="text" name="name" required class="w-full px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="如：Uniswap" />
      </div>

      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">官方网站 *</label>
        <input type="url" name="website" required class="w-full px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="https://..." />
      </div>

      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">分类 *</label>
        <select name="category" required class="w-full px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">请选择分类</option>
          <option value="exchange">交易所</option>
          <option value="wallet">钱包</option>
          <option value="market">行情与数据</option>
          <option value="defi">DeFi</option>
          <option value="nft">NFT</option>
          <option value="infra">基础设施</option>
          <option value="security">安全与审计</option>
          <option value="media">社区与媒体</option>
          <option value="tools">实用工具</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">项目简介</label>
        <textarea name="description" rows="3" class="w-full px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="简述项目是什么，做什么的..."></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Logo URL</label>
        <input type="url" name="logo" class="w-full px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="https://...logo.png" />
      </div>

      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">社交链接</label>
        <div class="grid grid-cols-2 gap-3">
          <input type="text" name="twitter" class="px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="Twitter 用户名" />
          <input type="text" name="telegram" class="px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="Telegram 群组" />
          <input type="text" name="github" class="px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="GitHub 仓库" />
          <input type="text" name="discord" class="px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="Discord 邀请" />
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">提交者邮箱</label>
        <input type="email" name="email" class="w-full px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="用于通知审核结果" />
      </div>

      <div class="flex items-start gap-2">
        <input type="checkbox" name="agree" required class="mt-1 rounded border-surface-300 text-brand-600 focus:ring-brand-500" />
        <label class="text-xs text-surface-500 dark:text-surface-400">
          我确认所提交的信息真实有效，且该项目有实际的产品或服务。我理解提交后将经过人工审核，审核结果将通过邮件通知。
        </label>
      </div>

      <button type="submit" class="btn-primary w-full">
        提交项目
      </button>

      <div id="submit-result" class="hidden p-4 rounded-lg bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800">
        <p class="text-sm text-green-700 dark:text-green-400">
          提交成功！我们将尽快审核，审核结果会通过邮件通知你。
        </p>
      </div>
    </form>
  </div>
</Layout>

<script>
  document.getElementById('submit-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const result = document.getElementById('submit-result');
    const form = e.target as HTMLFormElement;
    result?.classList.remove('hidden');
    form.reset();
    setTimeout(() => result?.classList.add('hidden'), 5000);
  });
</script>

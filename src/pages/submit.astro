---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Submit Project - CryptoNav" breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Submit Project' }]}>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-2xl font-bold text-surface-800 dark:text-surface-100 mb-2">Submit a Project</h1>
    <p class="text-sm text-surface-500 dark:text-surface-400 mb-8">Found a great project? Submit it to us and it will go live after review</p>

    <form class="space-y-5" id="submit-form">
      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Project Name *</label>
        <input type="text" name="name" required class="w-full px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="e.g. Uniswap" />
      </div>

      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Official Website *</label>
        <input type="url" name="website" required class="w-full px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="https://..." />
      </div>

      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Category *</label>
        <select name="category" required class="w-full px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">Select a category</option>
          <option value="exchange">Exchanges</option>
          <option value="wallet">Wallets</option>
          <option value="market">Markets & Data</option>
          <option value="defi">DeFi</option>
          <option value="nft">NFT</option>
          <option value="infra">Infrastructure</option>
          <option value="security">Security & Audit</option>
          <option value="media">Community & Media</option>
          <option value="tools">Tools</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Chains <span class="text-surface-400 font-normal">(optional)</span></label>
        <p class="text-xs text-surface-400 mb-2">Which blockchain(s) does this project operate on? Select all that apply.</p>
        <div class="flex flex-wrap gap-2" id="chain-tags">
          {[
            { id: 'ethereum', name: 'Ethereum', color: '#627EEA' },
            { id: 'solana', name: 'Solana', color: '#14F195' },
            { id: 'bsc', name: 'BNB Chain', color: '#F0B90B' },
            { id: 'arbitrum', name: 'Arbitrum', color: '#28A0F0' },
            { id: 'base', name: 'Base', color: '#0052FF' },
            { id: 'polygon', name: 'Polygon', color: '#8247E5' },
            { id: 'avalanche', name: 'Avalanche', color: '#E84142' },
            { id: 'optimism', name: 'Optimism', color: '#FF0420' },
            { id: 'sui', name: 'Sui', color: '#4DA2FF' },
            { id: 'ton', name: 'TON', color: '#0098EA' },
          ].map(chain => (
            <label class="cursor-pointer">
              <input type="checkbox" name="chains" value={chain.id} class="hidden peer" />
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border border-surface-200 dark:border-surface-700 text-surface-500 dark:text-surface-400 peer-checked:bg-brand-50 peer-checked:border-brand-500 peer-checked:text-brand-700 dark:peer-checked:bg-brand-900/30 dark:peer-checked:text-brand-400 transition-colors">
                <span class="w-2 h-2 rounded-full" style={`background: ${chain.color}`}></span>
                {chain.name}
              </span>
            </label>
          ))}
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Project Description</label>
        <textarea name="description" rows="3" class="w-full px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="Briefly describe what the project is and does..."></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Logo URL</label>
        <input type="url" name="logo" class="w-full px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="https://...logo.png" />
      </div>

      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Social Links</label>
        <div class="grid grid-cols-2 gap-3">
          <input type="text" name="twitter" class="px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="Twitter username" />
          <input type="text" name="telegram" class="px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="Telegram group" />
          <input type="text" name="github" class="px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="GitHub repo" />
          <input type="text" name="discord" class="px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="Discord invite" />
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">Your Email</label>
        <input type="email" name="email" class="w-full px-4 py-2.5 text-sm rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="We'll notify you of the review result" />
      </div>

      <div class="flex items-start gap-2">
        <input type="checkbox" name="agree" required class="mt-1 rounded border-surface-300 text-brand-600 focus:ring-brand-500" />
        <label class="text-xs text-surface-500 dark:text-surface-400">
          I confirm the submitted information is true and accurate, and the project has a real product or service. I understand submissions will be manually reviewed and results notified by email.
        </label>
      </div>

      <button type="submit" id="submit-btn" class="btn-primary w-full">
        <span id="submit-btn-text">Submit Project</span>
      </button>

      <div id="submit-result" class="hidden p-4 rounded-lg bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800">
        <p class="text-sm text-green-700 dark:text-green-400">
          Submitted successfully! We'll review it soon and notify you by email.
        </p>
      </div>

      <div id="submit-error" class="hidden p-4 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800">
        <p class="text-sm text-red-700 dark:text-red-400" id="submit-error-msg">
          Something went wrong. Please try again.
        </p>
      </div>
    </form>
  </div>
</Layout>

<script>
  const form = document.getElementById('submit-form') as HTMLFormElement | null;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('submit-btn-text');
  const result = document.getElementById('submit-result');
  const errorBox = document.getElementById('submit-error');
  const errorMsg = document.getElementById('submit-error-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form) return;

    // Reset UI
    result?.classList.add('hidden');
    errorBox?.classList.add('hidden');

    // Disable button, show loading
    if (btn) btn.disabled = true;
    if (btnText) btnText.textContent = 'Submitting...';

    // Gather form data
    const formData = new FormData(form);
    const payload: Record<string, string | string[]> = {};
    formData.forEach((value, key) => {
      if (key === 'chains') {
        if (!payload['chains']) payload['chains'] = [];
        (payload['chains'] as string[]).push(value.toString().trim());
      } else {
        payload[key] = value.toString().trim();
      }
    });

    try {
      const res = await fetch('/api/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();

      if (res.ok && data.success) {
        result?.classList.remove('hidden');
        form.reset();
      } else {
        if (errorMsg) errorMsg.textContent = data.error || data.message || 'Submission failed. Please try again.';
        errorBox?.classList.remove('hidden');
      }
    } catch (err) {
      if (errorMsg) errorMsg.textContent = 'Network error. Please check your connection and try again.';
      errorBox?.classList.remove('hidden');
    } finally {
      if (btn) btn.disabled = false;
      if (btnText) btnText.textContent = 'Submit Project';
    }
  });
</script>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Partnerships - CryptoNav">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-2xl font-bold text-surface-800 dark:text-surface-100 mb-2">Partner with CryptoNav</h1>
    <p class="text-sm text-surface-500 dark:text-surface-400 mb-8">Reach a global, crypto-savvy audience through tasteful, native placements across our navigation pages.</p>

    <!-- Placement options (no public pricing) -->
    <div class="space-y-6 mb-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 p-6">
          <h3 class="font-bold text-surface-800 dark:text-surface-100 mb-2">Homepage Placement</h3>
          <p class="text-xs text-surface-400">Prime homepage position, supports image or HTML5 creative.</p>
        </div>

        <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 p-6">
          <h3 class="font-bold text-surface-800 dark:text-surface-100 mb-2">Sidebar Placement</h3>
          <p class="text-xs text-surface-400">Category page sidebars, sticky on scroll for lasting visibility.</p>
        </div>

        <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 p-6">
          <h3 class="font-bold text-surface-800 dark:text-surface-100 mb-2">Inline Listing</h3>
          <p class="text-xs text-surface-400">Native card inserted in project listings, matching our card style.</p>
        </div>

        <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 p-6">
          <h3 class="font-bold text-surface-800 dark:text-surface-100 mb-2">Featured / Sponsored</h3>
          <p class="text-xs text-surface-400">Homepage featured pick with badge, pinned ranking and priority search.</p>
        </div>
      </div>
    </div>

    <!-- Contact -->
    <div class="bg-surface-50 dark:bg-surface-800 rounded-xl p-6 text-center">
      <h2 class="font-bold text-surface-800 dark:text-surface-100 mb-2">Let's Talk</h2>
      <p class="text-sm text-surface-500 dark:text-surface-400 mb-4">Tell us about your project and goals — we'll put together a tailored plan that fits your budget.</p>
      <div class="flex items-center justify-center gap-4 text-sm">
        <a href="mailto:advertise@cryptonav.com" class="text-brand-600 dark:text-brand-400 hover:underline">advertise@cryptonav.com</a>
        <span class="text-surface-300">|</span>
        <a href="https://t.me/cryptonav" class="text-brand-600 dark:text-brand-400 hover:underline">@cryptonav</a>
      </div>
    </div>
  </div>
</Layout>

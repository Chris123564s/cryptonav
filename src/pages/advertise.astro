---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Advertise - CryptoNav">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-2xl font-bold text-surface-800 dark:text-surface-100 mb-2">Advertise with Us</h1>
    <p class="text-sm text-surface-500 dark:text-surface-400 mb-8">Showcase your project on CryptoNav and reach a precise crypto-savvy audience</p>

    <!-- Ad Slots -->
    <div class="space-y-6 mb-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Home Banner -->
        <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 p-6">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-bold text-surface-800 dark:text-surface-100">Home Banner</h3>
            <span class="px-2 py-0.5 text-xs font-medium rounded bg-accent-500/10 text-accent-600 dark:text-accent-400">Popular</span>
          </div>
          <p class="text-xs text-surface-400 mb-3">Prime homepage position, 1920x300, supports image/HTML5</p>
          <div class="flex items-baseline gap-1">
            <span class="text-2xl font-bold text-surface-800 dark:text-surface-100">$420</span>
            <span class="text-xs text-surface-400">/mo</span>
          </div>
        </div>

        <!-- Sidebar Top -->
        <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 p-6">
          <h3 class="font-bold text-surface-800 dark:text-surface-100 mb-3">Sidebar Ad (Top)</h3>
          <p class="text-xs text-surface-400 mb-3">Top of category page sidebar, 300x250, sticky on scroll</p>
          <div class="flex items-baseline gap-1">
            <span class="text-2xl font-bold text-surface-800 dark:text-surface-100">$210</span>
            <span class="text-xs text-surface-400">/mo</span>
          </div>
        </div>

        <!-- Sidebar Bottom -->
        <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 p-6">
          <h3 class="font-bold text-surface-800 dark:text-surface-100 mb-3">Sidebar Ad (Bottom)</h3>
          <p class="text-xs text-surface-400 mb-3">Bottom of category page sidebar, 300x250 or 300x600</p>
          <div class="flex items-baseline gap-1">
            <span class="text-2xl font-bold text-surface-800 dark:text-surface-100">$140</span>
            <span class="text-xs text-surface-400">/mo</span>
          </div>
        </div>

        <!-- Inline Card -->
        <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 p-6">
          <h3 class="font-bold text-surface-800 dark:text-surface-100 mb-3">Inline Ad Card</h3>
          <p class="text-xs text-surface-400 mb-3">Inserted in project listings, matches project card style</p>
          <div class="flex items-baseline gap-1">
            <span class="text-2xl font-bold text-surface-800 dark:text-surface-100">$110</span>
            <span class="text-xs text-surface-400">/mo</span>
          </div>
        </div>
      </div>

      <!-- Sponsored Listing -->
      <div class="bg-gradient-to-r from-brand-600 to-brand-700 rounded-xl p-6 text-white">
        <div class="flex items-start justify-between flex-wrap gap-4">
          <div>
            <h3 class="font-bold text-lg mb-1">Sponsored Listing / Top Placement</h3>
            <p class="text-sm text-brand-100 mb-3">Get your project featured in the homepage picks section for maximum exposure</p>
            <ul class="text-xs text-brand-100 space-y-1">
              <li>Homepage featured carousel (with "Sponsored" badge)</li>
              <li>Pinned at top of its category page</li>
              <li>Priority ranking in search results</li>
              <li>Custom pitch + affiliate link supported</li>
            </ul>
          </div>
          <div class="text-right">
            <div class="text-3xl font-bold">$700</div>
            <div class="text-xs text-brand-200">/mo</div>
            <a href="mailto:advertise@cryptonav.com" class="inline-block mt-3 bg-white/20 hover:bg-white/30 px-4 py-2 rounded-lg text-xs font-medium transition-colors">Contact Sales</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact -->
    <div class="bg-surface-50 dark:bg-surface-800 rounded-xl p-6 text-center">
      <h2 class="font-bold text-surface-800 dark:text-surface-100 mb-2">Contact Us</h2>
      <p class="text-sm text-surface-500 dark:text-surface-400 mb-4">Fill out the form below or email us directly — we'll reply within 24 hours</p>
      <div class="flex items-center justify-center gap-4 text-sm">
        <a href="mailto:advertise@cryptonav.com" class="text-brand-600 dark:text-brand-400 hover:underline">advertise@cryptonav.com</a>
        <span class="text-surface-300">|</span>
        <a href="https://t.me/cryptonav" class="text-brand-600 dark:text-brand-400 hover:underline">@cryptonav</a>
      </div>
    </div>
  </div>
</Layout>

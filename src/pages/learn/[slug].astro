---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import learnData from '../../data/learn.json';
// aliased: the page already binds `article` to the current guide
import { article as articleSchema } from '../../utils/schema';

export function getStaticPaths() {
  const articles = (learnData as any).articles ?? learnData;
  return articles.map((article: any) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

// Format article body (handle **bold** and paragraphs)
function formatBody(body: string): string {
  return body
    .split('\n')
    .map((line: string) => {
      if (line.trim() === '') return '';
      // Handle **bold** markers
      let formatted = line.replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold text-surface-800 dark:text-surface-100">$1</strong>');
      // Handle numbered lists
      if (/^\d+\.\s/.test(line.trim())) {
        return `<p class="ml-4">${formatted}</p>`;
      }
      // Handle bullet lists
      if (line.trim().startsWith('- ')) {
        return `<p class="ml-4">• ${formatted.replace(/^- /, '')}</p>`;
      }
      // Handle tables (pipe-delimited)
      if (line.includes('|') && !line.includes('|---')) {
        const cells = line.split('|').filter((c: string) => c.trim() !== '');
        if (line.includes('---') || line.includes('---|')) return '';
        return `<p class="flex gap-2"><span class="text-surface-400">|</span>${cells.map((c: string) => `<span class="text-surface-600 dark:text-surface-300">${c.trim()}</span>`).join('<span class="text-surface-400">|</span>')}<span class="text-surface-400">|</span></p>`;
      }
      if (line.includes('---|') || line.match(/^\|---/)) return '';
      return `<p class="text-surface-600 dark:text-surface-300">${formatted}</p>`;
    })
    .join('\n');
}

// Related articles
const allArticles = (learnData as any).articles ?? learnData;
const related = (allArticles as any[])
  .filter((a: any) => a.slug !== article.slug && a.category === article.category)
  .slice(0, 3);

// Directory CTA target.
// `article.category` is a DISPLAY label ("DeFi", "Education", ...), NOT a
// directory category id — linking straight to /category/{article.category}
// produced 404s. Each article carries an explicit `directoryCategory` that is
// guaranteed to exist in categories.json.
import categoriesData from '../../data/categories.json';
const directoryCats = (categoriesData as any[]) ?? [];
const dirCat =
  directoryCats.find((c: any) => c.id === article.directoryCategory) ?? directoryCats[0];

// Breadcrumb
const catColors: Record<string, string> = {
  'DeFi': 'bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400',
  'Trading': 'bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400',
  'Education': 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400',
  'Technology': 'bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400',
};

// Structured data for the guide.
const learnSchema = articleSchema({
  headline: article.title,
  description: article.description,
  url: `/learn/${article.slug}`,
  datePublished: article.publishedAt,
  authorName: article.author,
  keywords: [article.keyword, ...(article.tags || [])],
});
---

<Layout
  title={`${article.title} | CryptoNav`}
  description={article.description}
  canonical={`https://cryptonav.site/learn/${article.slug}`}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Learn', url: '/learn' },
    { name: article.title },
  ]}
  schema={learnSchema}
>
  <!-- Breadcrumb -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <nav class="flex items-center gap-2 text-xs text-surface-400">
      <a href="/" class="hover:text-brand-500">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <a href="/learn" class="hover:text-brand-500">Learn</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-surface-600 dark:text-surface-300 truncate">{article.keyword}</span>
    </nav>
  </div>

  <!-- Article header -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-center gap-2 mb-4">
      <span class={`text-[10px] px-2 py-0.5 rounded-full font-semibold ${catColors[article.category] || catColors['Education']}`}>{article.category}</span>
      <span class="text-[10px] text-surface-400">{article.readTime} min read</span>
      <span class="text-[10px] text-surface-400">·</span>
      <span class="text-[10px] text-surface-400">{article.publishedAt}</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-bold text-surface-800 dark:text-surface-100 leading-tight">{article.title}</h1>
    <p class="text-base text-surface-500 dark:text-surface-400 mt-3">{article.description}</p>
    <div class="flex items-center gap-3 mt-4 pt-4 border-t border-surface-200 dark:border-surface-700">
      <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand-500 to-accent-500 flex items-center justify-center text-white text-xs font-bold">CN</div>
      <div>
        <div class="text-sm font-medium text-surface-700 dark:text-surface-200">{article.author}</div>
        <div class="text-xs text-surface-400">Reviewed by CryptoNav Editorial Team</div>
      </div>
    </div>
  </section>

  <!-- Top banner ad -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
    <AdBanner slot="article-top" format="banner" />
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row gap-8">
    <!-- Table of contents (sticky on desktop) -->
    <aside class="lg:w-56 lg:shrink-0">
      <div class="lg:sticky lg:top-20">
        <div class="text-xs font-semibold text-surface-400 uppercase mb-3">Table of Contents</div>
        <nav class="flex flex-col gap-1">
          {article.toc.map((item: any, i: number) => (
            <a href={`#${item.id}`} class="text-xs text-surface-500 hover:text-brand-600 dark:text-surface-400 dark:hover:text-brand-400 transition-colors py-1 border-l-2 border-transparent hover:border-brand-400 pl-3">
              {i + 1}. {item.title}
            </a>
          ))}
        </nav>
      </div>
    </aside>

    <!-- Article body -->
    <article class="flex-1 min-w-0">
      {article.sections.map((section: any) => (
        <section id={section.id} class="mb-8 scroll-mt-20">
          <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100 mb-3">{section.heading}</h2>
          <div class="prose prose-sm dark:prose-invert max-w-none text-sm leading-relaxed text-surface-600 dark:text-surface-300 space-y-2" set:html={formatBody(section.body)}></div>
        </section>
      ))}

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mt-8 pt-6 border-t border-surface-200 dark:border-surface-700">
        {article.tags.map((tag: string) => (
          <span class="text-xs px-3 py-1 rounded-full bg-surface-100 dark:bg-surface-700 text-surface-500 dark:text-surface-400">#{tag}</span>
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-8 p-6 rounded-2xl bg-gradient-to-br from-brand-600 to-accent-500 text-white text-center">
        <h3 class="text-base font-bold mb-1">Explore Crypto Projects</h3>
        <p class="text-sm text-white/80 mb-3">Browse our curated directory of {dirCat.name} projects and tools.</p>
        <a href={`/category/${dirCat.id}`} class="inline-block px-5 py-2 rounded-lg bg-white/20 hover:bg-white/30 text-sm font-semibold transition-colors">Browse {dirCat.name} →</a>
      </div>

      <!-- Mid-article ad -->
      <div class="mt-8">
        <AdBanner slot="article-bottom" format="banner" />
      </div>
    </article>
  </div>

  <!-- Related articles -->
  {related.length > 0 && (
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 mt-4 border-t border-surface-200 dark:border-surface-700">
      <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100 mb-4">Related Guides</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {related.map((a: any) => (
          <a href={`/learn/${a.slug}`} class="group rounded-xl border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 p-5 hover:shadow-md hover:border-brand-300 dark:hover:border-brand-600 transition-all">
            <h3 class="text-sm font-bold text-surface-800 dark:text-surface-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors mb-1">{a.title}</h3>
            <p class="text-xs text-surface-500 dark:text-surface-400 line-clamp-2">{a.description}</p>
            <div class="text-[10px] text-surface-400 mt-2">{a.readTime} min · {a.publishedAt}</div>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>

<script is:inline>
  // Smooth scroll to anchor on click
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      const href = this.getAttribute('href');
      if (href && href.length > 1) {
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>

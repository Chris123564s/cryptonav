---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import learnData from '../../data/learn.json';
import { collectionPage, itemList } from '../../utils/schema';

const articles = (learnData as any).articles ?? learnData;

// Group by category
const categories = [...new Set(articles.map((a: any) => a.category))];

// Category colors
const catColors: Record<string, string> = {
  'DeFi': 'bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400',
  'Trading': 'bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400',
  'Education': 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400',
  'Technology': 'bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400',
};

const learnIndexSchema = [
  collectionPage({
    name: 'Crypto Guides & Education',
    description:
      'Free crypto education guides. Learn what is staking, what is DeFi, how to read crypto charts, Ethereum Layer 2, and more.',
    url: '/learn',
  }),
  itemList({
    name: 'Crypto guides and explainers',
    url: '/learn',
    items: (articles as any[]).map((a: any) => ({
      name: a.title,
      url: `/learn/${a.slug}`,
      description: a.description,
    })),
  }),
];
---

<Layout
  title="Crypto Guides & Education - Learn Crypto Basics | CryptoNav"
  description="Free crypto education guides. Learn what is staking, what is DeFi, how to read crypto charts, Ethereum Layer 2, and more. Beginner-friendly explanations."
  canonical="https://cryptonav.site/learn"
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Learn' }]}
  schema={learnIndexSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <nav class="flex items-center gap-2 text-xs text-surface-400">
      <a href="/" class="hover:text-brand-500">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-surface-600 dark:text-surface-300">Learn</span>
    </nav>
  </div>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-bold text-surface-800 dark:text-surface-100">Crypto Guides & Education</h1>
    <p class="text-base text-surface-500 dark:text-surface-400 mt-2 max-w-2xl">Learn the fundamentals of cryptocurrency, DeFi, trading, and blockchain technology. Free, beginner-friendly guides written by the CryptoNav team.</p>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
    <AdBanner slot="learn-banner" format="banner" />
  </div>

  <!-- Featured: Top articles by search volume -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
    <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100 mb-4 flex items-center gap-2">
      <span class="w-2 h-5 rounded-full bg-brand-500"></span>
      Most Popular Guides
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {articles.slice(0, 3).map((a: any) => (
        <a href={`/learn/${a.slug}`} class="group rounded-2xl border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 p-6 hover:shadow-lg hover:border-brand-300 dark:hover:border-brand-600 transition-all">
          <div class="flex items-center gap-2 mb-3">
            <span class={`text-[10px] px-2 py-0.5 rounded-full font-semibold ${catColors[a.category] || catColors['Education']}`}>{a.category}</span>
            <span class="text-[10px] text-surface-400">{a.readTime} min read</span>
          </div>
          <h3 class="text-base font-bold text-surface-800 dark:text-surface-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors mb-2">{a.title}</h3>
          <p class="text-sm text-surface-500 dark:text-surface-400 line-clamp-2">{a.description}</p>
          <div class="flex items-center gap-3 mt-4 text-xs text-surface-400">
            <span>{a.publishedAt}</span>
            <span>·</span>
            <span>{a.author}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- All articles by category -->
  {categories.map((cat: string) => {
    const catArticles = articles.filter((a: any) => a.category === cat);
    return (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
        <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100 mb-4 flex items-center gap-2">
          <span class={`w-2 h-5 rounded-full ${(catColors[cat] || '').includes('blue') ? 'bg-blue-500' : (catColors[cat] || '').includes('purple') ? 'bg-purple-500' : (catColors[cat] || '').includes('emerald') ? 'bg-emerald-500' : 'bg-amber-500'}`}></span>
          {cat}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {catArticles.map((a: any) => (
            <a href={`/learn/${a.slug}`} class="group rounded-xl border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 p-5 hover:shadow-md hover:border-brand-300 dark:hover:border-brand-600 transition-all flex items-start gap-4">
              <div class="flex-1 min-w-0">
                <h3 class="text-sm font-bold text-surface-800 dark:text-surface-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors mb-1">{a.title}</h3>
                <p class="text-xs text-surface-500 dark:text-surface-400 line-clamp-2 mb-2">{a.description}</p>
                <div class="flex items-center gap-2 text-[10px] text-surface-400">
                  <span>{a.readTime} min</span>
                  <span>·</span>
                  <span>{a.publishedAt}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    );
  })}

  <!-- SEO keyword badges -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
    <div class="rounded-2xl bg-surface-50 dark:bg-surface-800/50 border border-surface-200 dark:border-surface-700 p-6">
      <h2 class="text-sm font-bold text-surface-700 dark:text-surface-200 mb-3">Topics We Cover</h2>
      <div class="flex flex-wrap gap-2">
        {articles.map((a: any) => (
          <a href={`/learn/${a.slug}`} class="text-xs px-3 py-1.5 rounded-full bg-white dark:bg-surface-800 border border-surface-200 dark:border-surface-700 text-surface-600 dark:text-surface-300 hover:border-brand-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
            {a.keyword}
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

---
/**
 * Embeddable safety badge.
 *
 * This exists for one strategic reason: DefiLlama and DexScreener did not build
 * their link profiles by publishing articles, they built them by being
 * embedded on other people's pages. Every site that drops this iframe in gives
 * us a contextual, editorial link back — the kind that cannot be bought.
 *
 * It is deliberately dependency-free and renders in ~1KB: a badge nobody
 * embeds because it is heavy is worth nothing.
 */
import { projects, getSafety, gradeColor } from '../../utils/data';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: (typeof projects)[0];
}

const { project } = Astro.props;
const s = getSafety(project.id);
const rated = s && s.score !== null;
const color = gradeColor(s?.grade ?? '');
const profile = `https://cryptonav.site/verify/${project.id}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{project.name} safety rating — CryptoNav</title>
    <style>
      :root { color-scheme: light dark; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: transparent;
      }
      a.card {
        display: flex;
        align-items: center;
        gap: 10px;
        height: 132px;
        padding: 12px;
        border-radius: 12px;
        border: 1px solid #e4e4ec;
        background: #fff;
        color: #1a1a2e;
        text-decoration: none;
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      a.card:hover { border-color: #00b87a; box-shadow: 0 2px 10px rgba(0,0,0,.07); }
      @media (prefers-color-scheme: dark) {
        a.card { background: #17171f; border-color: #2c2c38; color: #ececf1; }
      }
      .score {
        flex: 0 0 58px;
        height: 58px;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 22px;
        line-height: 1;
      }
      .score span { font-size: 9px; font-weight: 600; letter-spacing: .06em; opacity: .75; margin-top: 3px; }
      .meta { min-width: 0; flex: 1; }
      .name { font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .since { font-size: 11px; opacity: .6; margin-top: 2px; }
      .inc { font-size: 11px; margin-top: 5px; }
      .brand { font-size: 9px; letter-spacing: .08em; text-transform: uppercase; opacity: .45; margin-top: 7px; }
    </style>
  </head>
  <body>
    <a class="card" href={profile} target="_blank" rel="noopener">
      <div class="score" style={`background:${color}1f;color:${color}`}>
        {rated ? s!.score : '—'}
        <span>{rated ? `GRADE ${s!.grade}` : 'UNRATED'}</span>
      </div>
      <div class="meta">
        <div class="name">{project.name}</div>
        <div class="since">
          {s?.firstSeenAt
            ? `Online since ${s.firstSeenAt}`
            : s?.domainRegisteredAt
              ? `Domain registered ${s.domainRegisteredAt}`
              : 'Domain age not verified'}
        </div>
        <div class="inc">
          {s && s.incidentCount > 0
            ? `${s.incidentCount} recorded incident${s.incidentCount === 1 ? '' : 's'}`
            : 'No incident on record'}
        </div>
        <div class="brand">Verified by CryptoNav</div>
      </div>
    </a>
  </body>
</html>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import AdBanner from '../../components/AdBanner.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { categories, getProjectsByParentCategory, getCategoryById, getReferralUrl } from '../../utils/data';
import { collectionPage, itemList } from '../../utils/schema';

export async function getStaticPaths() {
  return categories.map(cat => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}

interface Props {
  category: typeof categories[0];
}

const { category } = Astro.props;
const projects = getProjectsByParentCategory(category.id);

// `{n}` keeps the metadata honest about how many projects we actually list;
// see scripts/apply-category-meta.mjs for why the count is not hard-coded.
const seoTitle = category.seoTitle ?? `${category.name} - CryptoNav`;
const seoDescription = (category.seoDescription ?? category.description)
  .replace('{n}', String(projects.length));

// SEO depth: original intro copy + links into guides/comparisons for this
// category. The intro uses the category's own seoDescription (already written,
// previously only used as a meta tag) so the page carries real prose, not just
// a project grid.
const introCopy = (category.seoDescription ?? category.description)
  .replace('{n}', String(projects.length));

import learnData from '../../data/learn.json';
const allArticles = (learnData as any).articles ?? learnData;
const categoryGuides = allArticles
  .filter((a: any) => a.directoryCategory === category.id)
  .slice(0, 3);

import comparisonsData from '../../data/comparisons.json';
const comparisons = (comparisonsData as any).comparisons ?? comparisonsData;
const categoryCompares = (comparisons as any[])
  .filter((c: any) => (c.category ?? '').toLowerCase() === category.name.toLowerCase())
  .slice(0, 3);

const categoryUrl = `/category/${category.slug}`;
const categorySchema = [
  collectionPage({
    name: category.name,
    description: category.description,
    url: categoryUrl,
  }),
  itemList({
    name: `Best ${category.name} projects and tools`,
    url: categoryUrl,
    items: projects.map((p) => ({
      name: p.name,
      url: getReferralUrl(p),
      description: p.description,
    })),
  }),
].filter((node: any) => node['@type'] !== 'ItemList' || node.numberOfItems > 0);
---

<Layout
  title={seoTitle}
  description={seoDescription}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: category.name }]}
  schema={categorySchema}
>
  <!-- Breadcrumb -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <nav class="flex items-center gap-2 text-xs text-surface-400">
      <a href="/" class="hover:text-brand-500">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-surface-600 dark:text-surface-300">{category.name}</span>
    </nav>
  </div>

  <!-- Category Header -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <h1 class="text-2xl font-bold text-surface-800 dark:text-surface-100">{category.name}</h1>
    <p class="text-sm text-surface-500 dark:text-surface-400 mt-1">{category.description} · {projects.length} projects</p>

    <!-- SEO intro copy (uses the category's own seoDescription as real prose) -->
    <p class="text-sm text-surface-600 dark:text-surface-300 leading-relaxed mt-4 max-w-3xl">{introCopy}</p>

    {(categoryGuides.length > 0 || categoryCompares.length > 0) && (
      <div class="flex flex-wrap gap-x-6 gap-y-2 mt-4 text-sm">
        {categoryGuides.map((a: any) => (
          <a href={`/learn/${a.slug}`} class="text-brand-600 dark:text-brand-400 hover:underline">
            {a.title}
          </a>
        ))}
        {categoryCompares.map((c: any) => (
          <a href={`/compare/${c.slug}`} class="text-brand-600 dark:text-brand-400 hover:underline">
            {c.title}
          </a>
        ))}
      </div>
    )}

    <!-- Subcategory Filter -->
    <div class="flex flex-wrap gap-2 mt-4" id="subcategory-filters">
      <button class="px-3 py-1.5 text-xs font-medium rounded-lg bg-brand-600 text-white filter-btn active" data-filter="all">
        All ({projects.length})
      </button>
      {category.subcategories.map(sub => {
        const count = projects.filter(p => p.category === sub.id).length;
        return (
          <button class={`px-3 py-1.5 text-xs font-medium rounded-lg bg-surface-100 dark:bg-surface-800 text-surface-600 dark:text-surface-300 hover:bg-surface-200 dark:hover:bg-surface-700 filter-btn transition-colors`} data-filter={sub.id}>
            {sub.name} ({count})
          </button>
        );
      })}
    </div>
  </div>

  <!-- Projects + Sidebar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-4 gap-6 pb-12">
    <!-- Projects Grid -->
    <div class="lg:col-span-3">
      <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {projects.map((project, index) => (
          <>
            {/* Insert inline ad every 8 projects */}
            {index > 0 && index % 8 === 0 && (
              <div class="md:col-span-2">
                <AdBanner slot="inline-card" format="inline" />
              </div>
            )}
            <div class="project-item" data-category={project.category}>
              <ProjectCard project={project} />
            </div>
          </>
        ))}
      </div>

      {projects.length === 0 && (
        <div class="text-center py-20">
          <p class="text-surface-400">No projects yet. <a href="/submit" class="text-brand-500 hover:underline">Submit one</a></p>
        </div>
      )}
    </div>

    <!-- Sidebar -->
    <aside class="lg:col-span-1 space-y-6">
      <AdBanner slot="sidebar-top" format="sidebar" />

      <!-- Related Categories -->
      <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 p-5">
        <h3 class="font-semibold text-sm text-surface-800 dark:text-surface-100 mb-3">Related Categories</h3>
        <ul class="space-y-2">
          {categories.filter(c => c.id !== category.id).slice(0, 6).map(cat => (
            <li>
              <a href={`/category/${cat.slug}`} class="text-sm text-surface-500 hover:text-brand-500 transition-colors flex items-center justify-between">
                <span>{cat.name}</span>
                <svg class="w-3 h-3 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <AdBanner slot="sidebar-bottom" format="sidebar" />
    </aside>
  </div>
</Layout>

<script>
  // Subcategory filter
  const buttons = document.querySelectorAll('.filter-btn');
  const items = document.querySelectorAll('.project-item');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update active state
      buttons.forEach(b => {
        b.classList.remove('active', 'bg-brand-600', 'text-white');
        b.classList.add('bg-surface-100', 'dark:bg-surface-800', 'text-surface-600', 'dark:text-surface-300');
      });
      btn.classList.add('active', 'bg-brand-600', 'text-white');
      btn.classList.remove('bg-surface-100', 'dark:bg-surface-800', 'text-surface-600', 'dark:text-surface-300');

      // Filter items
      items.forEach(item => {
        const category = item.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });
  });
</script>

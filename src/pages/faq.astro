---
import Layout from '../layouts/Layout.astro';
import AdBanner from '../components/AdBanner.astro';
import faqData from '../data/faq.json';

const groups = faqData.groups;
const total = groups.reduce((n, g) => n + g.items.length, 0);

// FAQPage structured data — the whole point is that Google can render these
// directly in the results page, so every question/answer pair is emitted.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: groups.flatMap((g) =>
    g.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    }))
  ),
};
---

<Layout
  title="FAQ - CryptoNav"
  description={`Answers to ${total} common questions about CryptoNav: how we pick projects, what Sponsored means, and the crypto basics — CEX vs DEX, hot vs cold wallets, staking, stablecoins, Layer 2 and staying safe from scams.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <nav class="flex items-center gap-2 text-xs text-surface-400 mb-6">
      <a href="/" class="hover:text-brand-500">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-surface-600 dark:text-surface-300">FAQ</span>
    </nav>

    <h1 class="text-2xl font-bold text-surface-800 dark:text-surface-100">Frequently Asked Questions</h1>
    <p class="text-sm text-surface-500 dark:text-surface-400 mt-2">
      {total} answers covering how CryptoNav works, how to use the directory, and the crypto fundamentals
      behind the categories we list.
    </p>

    <!-- Group jump links -->
    <div class="flex flex-wrap gap-2 mt-5">
      {groups.map(g => (
        <a href={`#${g.id}`} class="inline-block px-3 py-1.5 text-xs rounded-lg bg-surface-100 dark:bg-surface-700 text-surface-600 dark:text-surface-300 hover:bg-brand-100 dark:hover:bg-brand-900/40 hover:text-brand-700 dark:hover:text-brand-300 transition-colors">
          {g.title} ({g.items.length})
        </a>
      ))}
    </div>

    <AdBanner slot="article-top" format="banner" className="mt-6" />

    <div class="mt-8 space-y-10">
      {groups.map(g => (
        <section id={g.id} class="scroll-mt-20">
          <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100 mb-3">{g.title}</h2>
          <div class="space-y-2">
            {g.items.map(item => (
              <details class="group rounded-xl border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 overflow-hidden">
                <summary class="flex items-center justify-between gap-3 cursor-pointer px-4 py-3 text-sm font-medium text-surface-800 dark:text-surface-100 hover:bg-surface-50 dark:hover:bg-surface-700/40 transition-colors">
                  <span>{item.q}</span>
                  <svg class="w-4 h-4 shrink-0 text-surface-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="px-4 pb-4 text-sm text-surface-600 dark:text-surface-300 leading-relaxed border-t border-surface-100 dark:border-surface-700 pt-3">
                  {item.a}
                </div>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>

    <AdBanner slot="article-bottom" format="banner" className="mt-10" />

    <div class="mt-10 p-6 rounded-2xl bg-surface-50 dark:bg-surface-800/50 border border-surface-200 dark:border-surface-700 text-center">
      <h3 class="text-sm font-bold text-surface-800 dark:text-surface-100">Still have a question?</h3>
      <p class="text-xs text-surface-500 dark:text-surface-400 mt-1">
        For listings and partnerships use the Advertise page; for anything else, email us.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 mt-4">
        <a href="/submit" class="px-4 py-2 rounded-lg bg-brand-600 text-white text-sm font-semibold hover:bg-brand-700 transition-colors">Submit a project</a>
        <a href="/advertise" class="px-4 py-2 rounded-lg bg-white dark:bg-surface-700 border border-surface-200 dark:border-surface-600 text-sm font-semibold text-surface-700 dark:text-surface-200 hover:border-brand-400 transition-colors">Advertise</a>
        <a href="mailto:hello@cryptonav.site" class="px-4 py-2 rounded-lg bg-white dark:bg-surface-700 border border-surface-200 dark:border-surface-600 text-sm font-semibold text-surface-700 dark:text-surface-200 hover:border-brand-400 transition-colors">hello@cryptonav.site</a>
      </div>
    </div>

  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import AdBanner from '../components/AdBanner.astro';
import winsData from '../data/wins.json';
import { collectionPage, itemList } from '../utils/schema';

const wins = (winsData as any).wins ?? winsData;
const dataDate = wins[0]?.date || '';

function fmtPrice(v: number): string {
  if (v >= 1) return `$${v.toLocaleString('en-US', { maximumFractionDigits: 4 })}`;
  if (v >= 0.01) return `$${v.toFixed(4)}`;
  return `$${v.toPrecision(3)}`;
}
function fmtChange(v: number): string {
  return `${v >= 0 ? '+' : ''}${v.toFixed(1)}%`;
}

// Sort by 6h change descending: the "momentum" view.
const sorted = [...wins].sort((a: any, b: any) => (b.change6h || 0) - (a.change6h || 0));

const winsSchema = [
  collectionPage({
    name: 'DEX Momentum Watch — Top 6h Movers',
    description:
      'A daily snapshot of the largest 6-hour price movers pulled from public DEX data. Market data only — not investment advice. Always verify a token before interacting.',
    url: '/wins',
  }),
  itemList({
    name: 'Top DEX 6h movers',
    url: '/wins',
    items: sorted.slice(0, 10).map((w: any) => ({
      name: `${w.symbol} (${w.name})`,
      url: `https://dexscreener.com/${w.chain}/${w.address}`,
      description: `${w.symbol} on ${w.chain}: ${fmtChange(w.change6h)} over 6h, price ${fmtPrice(Number(w.price) || 0)}.`,
    })),
  }),
];
---

<Layout
  title="DEX Momentum Watch — Top 6h Movers (Daily Snapshot)"
  description="A daily snapshot of the largest 6-hour price movers on public DEXs. Not investment advice. Verify any token on CryptoNav before interacting."
  canonical="https://cryptonav.site/wins/"
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'DEX Momentum Watch' }]}
  schema={winsSchema}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <span class="inline-block px-2 py-0.5 text-[10px] font-bold rounded bg-surface-100 dark:bg-surface-700 text-surface-500 dark:text-surface-400 uppercase tracking-wide">Daily snapshot · {dataDate}</span>
    <h1 class="text-2xl md:text-3xl font-bold text-surface-800 dark:text-surface-100 mt-3">DEX Momentum Watch</h1>
    <p class="text-sm text-surface-500 dark:text-surface-400 mt-3 leading-relaxed max-w-2xl">
      The largest 6-hour price movers pulled from public DEX data. This is a transparency feed, not a recommendation —
      most short-term movers are high-volatility, unaudited tokens. Always check a contract's safety before touching it.
    </p>

    <!-- Risk banner: explicit, AdSense-safe framing -->
    <div class="mt-5 rounded-xl border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/20 p-4">
      <p class="text-sm text-amber-800 dark:text-amber-300 font-medium">⚠️ Not investment advice</p>
      <p class="text-xs text-amber-700 dark:text-amber-400 mt-1 leading-relaxed">
        Tokens listed here are ranked by short-term price movement only. A sharp move says nothing about legitimacy —
        many are unaudited or outright scams. Verify the contract, holder distribution, and incident history on CryptoNav
        before interacting with any of them. Market data is auto-refreshed daily from DexScreener.
      </p>
    </div>

    <!-- Ad -->
    <div class="my-6">
      <AdBanner slot="home-banner" format="banner" />
    </div>

    <!-- Momentum table -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {sorted.map((item: any) => (
        <a
          href={`https://dexscreener.com/${item.chain}/${item.address}`}
          target="_blank"
          rel="noopener nofollow"
          class="block p-4 rounded-xl bg-white dark:bg-surface-800 border border-surface-200 dark:border-surface-700 hover:border-brand-400 transition-colors"
        >
          <div class="flex items-center gap-3 mb-2">
            {item.logo ? (
              <img src={item.logo} alt={item.name} width="32" height="32" class="w-8 h-8 rounded-full object-cover" loading="lazy"
                   onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
            ) : null}
            <div class="w-8 h-8 rounded-full bg-brand-100 dark:bg-brand-900 items-center justify-center text-xs font-bold text-brand-600 dark:text-brand-400" style={item.logo ? 'display:none' : 'display:flex'}>{(item.symbol || '?').charAt(0)}</div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-surface-800 dark:text-surface-100 truncate">{item.symbol}</div>
              <div class="text-[10px] text-surface-400 truncate">{item.name}</div>
            </div>
          </div>
          <div class="text-2xl font-extrabold text-green-500">{fmtChange(item.change6h)}</div>
          <div class="text-[10px] text-surface-400 mt-0.5">Price {fmtPrice(Number(item.price) || 0)} · {item.chain}</div>
        </a>
      ))}
    </div>

    <p class="text-xs text-surface-400 mt-6 text-center">
      Auto-refreshed daily from DexScreener top 6h movers. Market data only — not investment advice. DYOR.
      Verify any contract on CryptoNav before interacting.
    </p>
  </div>
</Layout>

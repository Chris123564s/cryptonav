---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { chains, getChainBySlug, getProjectsByChain } from '../../utils/data';

export async function getStaticPaths() {
  return chains.map(chain => ({
    params: { slug: chain.slug },
    props: { chain },
  }));
}

interface Props {
  chain: typeof chains[0];
}

const { chain } = Astro.props;
const projects = getProjectsByChain(chain.id);
const otherChains = chains.filter(c => c.id !== chain.id).slice(0, 6);
---

<Layout title={`${chain.name} Ecosystem - CryptoNav`} description={`${chain.name} chain projects: DEXes, DeFi, wallets, and tools on ${chain.name}. ${chain.description}`}>
  <!-- Breadcrumb -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <nav class="flex items-center gap-2 text-xs text-surface-400">
      <a href="/" class="hover:text-brand-500">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <a href="/#chains" class="hover:text-brand-500">Chains</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-surface-600 dark:text-surface-300">{chain.name}</span>
    </nav>
  </div>

  <!-- Chain Header -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-center gap-4">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center shrink-0" style={`background: ${chain.color}15; border: 1px solid ${chain.color}30`}>
        <span class="text-xl font-bold" style={`color: ${chain.color}`}>{chain.symbol.slice(0, 2)}</span>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-surface-800 dark:text-surface-100">{chain.name} Ecosystem</h1>
        <p class="text-sm text-surface-500 dark:text-surface-400 mt-1">{projects.length} projects · TVL Rank #{chain.tvlRank}</p>
      </div>
    </div>
    <p class="text-sm text-surface-500 dark:text-surface-400 mt-3 max-w-2xl">{chain.description}</p>
  </div>

  <!-- Chain Banner Ad (Premium slot) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
    <AdBanner slot="home-banner" format="banner" />
  </div>

  <!-- Projects + Sidebar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-4 gap-6 pb-12">
    <!-- Projects Grid -->
    <div class="lg:col-span-3">
      {projects.length > 0 ? (
        <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {projects.map((project, index) => (
            <>
              {index > 0 && index % 8 === 0 && (
                <div class="md:col-span-2">
                  <AdBanner slot="inline-card" format="inline" />
                </div>
              )}
              <ProjectCard project={project} />
            </>
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <p class="text-surface-400">No projects on {chain.name} yet.</p>
          <a href="/submit" class="text-brand-500 hover:underline text-sm mt-2 inline-block">Submit one</a>
        </div>
      )}
    </div>

    <!-- Sidebar -->
    <aside class="lg:col-span-1 space-y-6">
      <AdBanner slot="sidebar-top" format="sidebar" />

      <!-- Chain Info Card -->
      <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 p-5">
        <h3 class="font-semibold text-sm text-surface-800 dark:text-surface-100 mb-3">About {chain.name}</h3>
        <div class="space-y-2 text-xs text-surface-500 dark:text-surface-400">
          <div class="flex justify-between"><span>Symbol</span><span class="font-mono font-semibold" style={`color: ${chain.color}`}>{chain.symbol}</span></div>
          <div class="flex justify-between"><span>TVL Rank</span><span>#{chain.tvlRank}</span></div>
          <div class="flex justify-between"><span>Projects</span><span>{projects.length}</span></div>
        </div>
        <a href={chain.website} target="_blank" rel="noopener" class="mt-3 inline-block text-xs text-brand-500 hover:text-brand-600">
          Visit {chain.name} official →
        </a>
      </div>

      <!-- Other Chains -->
      <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 p-5">
        <h3 class="font-semibold text-sm text-surface-800 dark:text-surface-100 mb-3">Explore Chains</h3>
        <ul class="space-y-2">
          {otherChains.map(c => (
            <li>
              <a href={`/chain/${c.slug}`} class="text-sm text-surface-500 hover:text-brand-500 transition-colors flex items-center justify-between">
                <span class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full" style={`background: ${c.color}`}></span>
                  {c.name}
                </span>
                <span class="text-xs text-surface-400">{c.symbol}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <AdBanner slot="sidebar-bottom" format="sidebar" />
    </aside>
  </div>
</Layout>
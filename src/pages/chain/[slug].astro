---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import { chains, getTokensByChain, formatTokenPrice, formatMarketCap } from '../../utils/data';

export async function getStaticPaths() {
  return chains.map(chain => ({
    params: { slug: chain.slug },
    props: { chain },
  }));
}

interface Props {
  chain: typeof chains[0];
}

const { chain } = Astro.props;
const tokens = getTokensByChain(chain.id);
const otherChains = chains.filter(c => c.id !== chain.id).slice(0, 8);

// Calculate total stats
const totalMarketCap = tokens.reduce((sum, t) => sum + (t.marketCap || 0), 0);
const totalVolume = tokens.reduce((sum, t) => sum + (t.volume24h || 0), 0);
const totalTvl = tokens.reduce((sum, t) => sum + (t.tvl || 0), 0);
---

<Layout title={`${chain.name} Tokens & Prices - CryptoNav`} description={`Live prices, market cap, volume, and 24h change for the top tokens on ${chain.name}. Browse ${tokens.length}+ ${chain.name} cryptocurrencies ranked by market cap.`}>
  <!-- Breadcrumb -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <nav class="flex items-center gap-2 text-xs text-surface-400">
      <a href="/" class="hover:text-brand-500">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <a href="/#chains" class="hover:text-brand-500">Chains</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-surface-600 dark:text-surface-300">{chain.name}</span>
    </nav>
  </div>

  <!-- Chain Header -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-center gap-4">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center shrink-0" style={`background: ${chain.color}15; border: 1px solid ${chain.color}30`}>
        <span class="text-xl font-bold" style={`color: ${chain.color}`}>{chain.symbol.slice(0, 2)}</span>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-surface-800 dark:text-surface-100">{chain.name} Tokens</h1>
        <p class="text-sm text-surface-500 dark:text-surface-400 mt-1">{tokens.length} tokens · TVL Rank #{chain.tvlRank}</p>
      </div>
    </div>
    <p class="text-sm text-surface-500 dark:text-surface-400 mt-3 max-w-2xl">{chain.description}</p>

    <!-- Chain Stats -->
    <div class="flex flex-wrap gap-4 mt-4">
      <div class="bg-surface-50 dark:bg-surface-800/50 rounded-lg px-4 py-2 border border-surface-100 dark:border-surface-700">
        <span class="text-xs text-surface-400">Total Market Cap</span>
        <p class="text-sm font-semibold text-surface-700 dark:text-surface-200">{formatMarketCap(totalMarketCap)}</p>
      </div>
      <div class="bg-surface-50 dark:bg-surface-800/50 rounded-lg px-4 py-2 border border-surface-100 dark:border-surface-700">
        <span class="text-xs text-surface-400">24h Volume</span>
        <p class="text-sm font-semibold text-surface-700 dark:text-surface-200">{formatMarketCap(totalVolume)}</p>
      </div>
      <div class="bg-surface-50 dark:bg-surface-800/50 rounded-lg px-4 py-2 border border-surface-100 dark:border-surface-700">
        <span class="text-xs text-surface-400">Total TVL</span>
        <p class="text-sm font-semibold text-surface-700 dark:text-surface-200">{formatMarketCap(totalTvl)}</p>
      </div>
    </div>
  </div>

  <!-- Chain Banner Ad (Premium slot) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
    <AdBanner slot="home-banner" format="banner" />
  </div>

  <!-- Token Table -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    {tokens.length > 0 ? (
      <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 overflow-hidden">
        <!-- Sort Controls -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-surface-100 dark:border-surface-700 flex-wrap gap-2">
          <h2 class="text-sm font-semibold text-surface-700 dark:text-surface-200">Top Tokens on {chain.name}</h2>
          <div class="flex items-center gap-1.5 flex-wrap" id="sort-controls">
            <span class="text-xs text-surface-400 mr-1">Sort by:</span>
            <button class="sort-btn active" data-sort="marketcap">Market Cap</button>
            <button class="sort-btn" data-sort="volume">Volume</button>
            <button class="sort-btn" data-sort="price">Price</button>
            <button class="sort-btn" data-sort="change">24h Change</button>
            <button class="sort-btn" data-sort="recent">Recent</button>
          </div>
        </div>

        <!-- Desktop Table Header -->
        <div class="hidden md:grid grid-cols-[50px_2fr_120px_140px_120px_100px_120px] gap-2 px-4 py-2.5 text-xs font-semibold text-surface-400 uppercase tracking-wide border-b border-surface-100 dark:border-surface-700 bg-surface-50 dark:bg-surface-800/50">
          <div>#</div>
          <div>Token</div>
          <div class="text-right">Price</div>
          <div class="text-right">Market Cap</div>
          <div class="text-right">24h Volume</div>
          <div class="text-right">24h Change</div>
          <div class="text-center">Category</div>
        </div>

        <!-- Mobile Table Header -->
        <div class="grid grid-cols-[40px_1fr_90px_80px] md:hidden gap-2 px-4 py-2 text-xs font-semibold text-surface-400 uppercase border-b border-surface-100 dark:border-surface-700 bg-surface-50 dark:bg-surface-800/50">
          <div>#</div>
          <div>Token</div>
          <div class="text-right">Price</div>
          <div class="text-right">24h</div>
        </div>

        <!-- Table Body -->
        <div id="token-rows" class="divide-y divide-surface-100 dark:divide-surface-700">
          {tokens.map((t, i) => (
            <div class="token-row grid grid-cols-[40px_1fr_90px_80px] md:grid-cols-[50px_2fr_120px_140px_120px_100px_120px] gap-2 px-4 py-3 items-center hover:bg-surface-50 dark:hover:bg-surface-700/30 transition-colors"
                 data-marketcap={t.marketCap || 0}
                 data-volume={t.volume24h || 0}
                 data-price={t.price || 0}
                 data-change={t.priceChange24h || 0}
                 data-added={t.addedAt || ''}
                 data-sponsored={t.sponsored ? '1' : '0'}>
              <!-- Rank -->
              <div class="text-sm font-medium text-surface-400 flex items-center gap-0.5">
                {t.sponsored && <span class="text-amber-500" title="Sponsored"><svg class="w-3 h-3 inline" fill="currentColor" viewBox="0 0 20 20"><path d="M10 1l2.5 5.5L18 7l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5L10 1z"/></svg></span>}
                <span class="rank-num">{i + 1}</span>
              </div>

              <!-- Token (logo + symbol + name) -->
              <div class="flex items-center gap-2.5 min-w-0">
                {t.logo ? (
                  <div class="w-7 h-7 rounded-full shrink-0 overflow-hidden bg-surface-100 dark:bg-surface-700 flex items-center justify-center">
                    <img src={t.logo} alt={t.name} class="w-7 h-7 rounded-full object-cover" loading="lazy"
                         onerror="this.style.display='none';this.parentElement.classList.add('flex','items-center','justify-center');const s=document.createElement('span');s.className='text-xs font-bold text-white';s.style.background='{chain.color}';s.style.width='28px';s.style.height='28px';s.style.borderRadius='50%';s.style.display='flex';s.style.alignItems='center';s.style.justifyContent='center';s.textContent='{t.symbol.charAt(0)}';this.parentElement.appendChild(s)" />
                  </div>
                ) : (
                  <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold shrink-0 text-white" style={`background: ${chain.color}`}>
                    {t.symbol.charAt(0)}
                  </div>
                )}
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span class="text-sm font-semibold text-surface-800 dark:text-surface-100">{t.symbol}</span>
                    {t.verified && <svg class="w-3.5 h-3.5 text-brand-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>}
                  </div>
                  <p class="text-xs text-surface-400 truncate">{t.name}</p>
                </div>
              </div>

              <!-- Price -->
              <div class="text-right text-sm font-mono text-surface-700 dark:text-surface-200" data-display="price">
                {formatTokenPrice(t.price)}
              </div>

              <!-- Market Cap (desktop only) -->
              <div class="hidden md:block text-right text-sm font-mono text-surface-600 dark:text-surface-300" data-display="marketcap">
                {formatMarketCap(t.marketCap)}
              </div>

              <!-- 24h Volume (desktop only) -->
              <div class="hidden md:block text-right text-sm font-mono text-surface-600 dark:text-surface-300" data-display="volume">
                {formatMarketCap(t.volume24h)}
              </div>

              <!-- 24h Change -->
              <div class={`text-right text-sm font-mono font-medium ${(t.priceChange24h || 0) >= 0 ? 'text-green-500' : 'text-red-500'}`} data-display="change">
                {t.priceChange24h > 0 ? '+' : ''}{(t.priceChange24h || 0).toFixed(2)}%
              </div>

              <!-- Category (desktop only) -->
              <div class="hidden md:block text-center">
                <span class="inline-block text-[10px] px-2 py-0.5 rounded-full bg-surface-100 dark:bg-surface-700 text-surface-500 dark:text-surface-400">{t.category}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Mobile note -->
        <div class="md:hidden px-4 py-2 text-xs text-surface-400 border-t border-surface-100 dark:border-surface-700">
          Swipe to see more data. Rotate device for full table view.
        </div>
      </div>
    ) : (
      <div class="text-center py-20">
        <p class="text-surface-400">No tokens on {chain.name} yet.</p>
        <a href="/submit" class="text-brand-500 hover:underline text-sm mt-2 inline-block">Submit one</a>
      </div>
    )}
  </div>

  <!-- Other Chains -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <h2 class="text-sm font-semibold text-surface-700 dark:text-surface-200 mb-3">Explore Other Chains</h2>
    <div class="flex flex-wrap gap-2">
      {otherChains.map(c => (
        <a href={`/chain/${c.slug}`} class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-white dark:bg-surface-800 border border-surface-200 dark:border-surface-700 text-sm text-surface-600 dark:text-surface-300 hover:border-brand-300 dark:hover:border-brand-600 transition-colors">
          <span class="w-2.5 h-2.5 rounded-full" style={`background: ${c.color}`}></span>
          {c.name}
          <span class="text-xs text-surface-400">#{c.tvlRank}</span>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .sort-btn {
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    border: 1px solid var(--border-tertiary, #e0e0e8);
    background: transparent;
    color: var(--text-secondary, #666677);
    cursor: pointer;
    transition: all 0.15s;
  }
  .sort-btn:hover {
    border-color: #00b87a;
    color: #00b87a;
  }
  .sort-btn.active {
    background: #00b87a;
    border-color: #00b87a;
    color: #fff;
  }
  :global(.dark) .sort-btn {
    border-color: #444441;
    color: #aaaabb;
  }
  :global(.dark) .sort-btn:hover {
    border-color: #00b87a;
    color: #00b87a;
  }
  :global(.dark) .sort-btn.active {
    background: #00b87a;
    border-color: #00b87a;
    color: #fff;
  }
</style>

<script is:inline>
  (function() {
    const sortBtns = document.querySelectorAll('.sort-btn');
    const rows = Array.from(document.querySelectorAll('.token-row'));

    sortBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Update active state
        sortBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const sortKey = btn.getAttribute('data-sort');

        // Sort rows
        rows.sort((a, b) => {
          // Sponsored always first
          const aSp = a.getAttribute('data-sponsored') === '1';
          const bSp = b.getAttribute('data-sponsored') === '1';
          if (aSp && !bSp) return -1;
          if (!aSp && bSp) return 1;

          if (sortKey === 'marketcap') {
            return (parseFloat(b.getAttribute('data-marketcap') || '0')) - (parseFloat(a.getAttribute('data-marketcap') || '0'));
          }
          if (sortKey === 'volume') {
            return (parseFloat(b.getAttribute('data-volume') || '0')) - (parseFloat(a.getAttribute('data-volume') || '0'));
          }
          if (sortKey === 'price') {
            return (parseFloat(b.getAttribute('data-price') || '0')) - (parseFloat(a.getAttribute('data-price') || '0'));
          }
          if (sortKey === 'change') {
            return (parseFloat(b.getAttribute('data-change') || '0')) - (parseFloat(a.getAttribute('data-change') || '0'));
          }
          if (sortKey === 'recent') {
            return (b.getAttribute('data-added') || '').localeCompare(a.getAttribute('data-added') || '');
          }
          return 0;
        });

        // Re-render rank numbers
        const container = document.getElementById('token-rows');
        rows.forEach((row, i) => {
          const rankEl = row.querySelector('.rank-num');
          if (rankEl) rankEl.textContent = i + 1;
          if (container) container.appendChild(row);
        });
      });
    });
  })();
</script>

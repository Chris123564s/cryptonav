---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import { chains, getProjectsByChain, formatNumber } from '../../utils/data';

export async function getStaticPaths() {
  return chains.map(chain => ({
    params: { slug: chain.slug },
    props: { chain },
  }));
}

interface Props {
  chain: typeof chains[0];
}

const { chain } = Astro.props;
const projects = getProjectsByChain(chain.id);
const otherChains = chains.filter(c => c.id !== chain.id).slice(0, 8);

// Helper: get metric value for sorting
function getMetric(p: any, key: string): number {
  const m = p.metrics || {};
  return m[key] || 0;
}
---

<Layout title={`${chain.name} Ecosystem - CryptoNav`} description={`${chain.name} chain projects ranked by TVL, volume, and popularity. Browse the top projects on ${chain.name}.`}>
  <!-- Breadcrumb -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <nav class="flex items-center gap-2 text-xs text-surface-400">
      <a href="/" class="hover:text-brand-500">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <a href="/#chains" class="hover:text-brand-500">Chains</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-surface-600 dark:text-surface-300">{chain.name}</span>
    </nav>
  </div>

  <!-- Chain Header -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-center gap-4">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center shrink-0" style={`background: ${chain.color}15; border: 1px solid ${chain.color}30`}>
        <span class="text-xl font-bold" style={`color: ${chain.color}`}>{chain.symbol.slice(0, 2)}</span>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-surface-800 dark:text-surface-100">{chain.name} Ecosystem</h1>
        <p class="text-sm text-surface-500 dark:text-surface-400 mt-1">{projects.length} projects · TVL Rank #{chain.tvlRank}</p>
      </div>
    </div>
    <p class="text-sm text-surface-500 dark:text-surface-400 mt-3 max-w-2xl">{chain.description}</p>
  </div>

  <!-- Chain Banner Ad (Premium slot) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
    <AdBanner slot="home-banner" format="banner" />
  </div>

  <!-- Project Ranking Table -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    {projects.length > 0 ? (
      <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 overflow-hidden">
        <!-- Sort Controls -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-surface-100 dark:border-surface-700 flex-wrap gap-2">
          <h2 class="text-sm font-semibold text-surface-700 dark:text-surface-200">Projects on {chain.name}</h2>
          <div class="flex items-center gap-1.5 flex-wrap" id="sort-controls">
            <span class="text-xs text-surface-400 mr-1">Sort by:</span>
            <button class="sort-btn active" data-sort="tvl">TVL</button>
            <button class="sort-btn" data-sort="volume24h">Volume</button>
            <button class="sort-btn" data-sort="followers">Followers</button>
            <button class="sort-btn" data-sort="recent">Recent</button>
          </div>
        </div>

        <!-- Table Header -->
        <div class="hidden md:grid grid-cols-[40px_1fr_120px_100px_100px_80px] gap-2 px-4 py-2.5 text-xs font-semibold text-surface-400 uppercase tracking-wide border-b border-surface-100 dark:border-surface-700 bg-surface-50 dark:bg-surface-800/50">
          <div>#</div>
          <div>Project</div>
          <div class="text-right">Category</div>
          <div class="text-right" data-col="tvl">TVL</div>
          <div class="text-right" data-col="volume24h">24h Vol</div>
          <div class="text-center">Status</div>
        </div>
        <!-- Mobile header -->
        <div class="grid grid-cols-[40px_1fr_70px] md:hidden gap-2 px-4 py-2 text-xs font-semibold text-surface-400 uppercase border-b border-surface-100 dark:border-surface-700 bg-surface-50 dark:bg-surface-800/50">
          <div>#</div>
          <div>Project</div>
          <div class="text-right">Status</div>
        </div>

        <!-- Table Body -->
        <div id="project-rows" class="divide-y divide-surface-100 dark:divide-surface-700">
          {projects.map((p, i) => (
            <div class="project-row grid grid-cols-[40px_1fr_70px] md:grid-cols-[40px_1fr_120px_100px_100px_80px] gap-2 px-4 py-3 items-center hover:bg-surface-50 dark:hover:bg-surface-700/30 transition-colors"
                 data-tvl={getMetric(p, 'tvl')}
                 data-volume={getMetric(p, 'volume24h')}
                 data-followers={getMetric(p, 'twitterFollowers')}
                 data-added={p.addedAt || ''}
                 data-sponsored={p.sponsored ? '1' : '0'}>
              <!-- Rank -->
              <div class="text-sm font-medium text-surface-400 flex items-center">
                {p.sponsored && <span class="text-amber-500 mr-0.5" title="Sponsored"><svg class="w-3 h-3 inline" fill="currentColor" viewBox="0 0 20 20"><path d="M10 1l2.5 5.5L18 7l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5L10 1z"/></svg></span>}
                <span class="rank-num">{i + 1}</span>
              </div>

              <!-- Project -->
              <div class="flex items-center gap-2.5 min-w-0">
                {p.logo ? (
                  <img src={p.logo} alt={p.name} class="w-7 h-7 rounded-lg object-cover shrink-0" loading="lazy" />
                ) : (
                  <div class="w-7 h-7 rounded-lg bg-brand-100 dark:bg-brand-900 flex items-center justify-center text-xs font-bold text-brand-600 dark:text-brand-400 shrink-0">
                    {p.name.charAt(0)}
                  </div>
                )}
                <div class="min-w-0">
                  <a href={p.referral || p.website} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-surface-800 dark:text-surface-100 hover:text-brand-600 dark:hover:text-brand-400 transition-colors truncate block">
                    {p.name}
                  </a>
                  <p class="text-xs text-surface-400 truncate">{p.description}</p>
                </div>
              </div>

              <!-- Category -->
              <div class="hidden md:block text-right">
                <span class="text-xs text-surface-500 dark:text-surface-400">{(p.category || '').split('-')[0]}</span>
              </div>

              <!-- TVL -->
              <div class="hidden md:block text-right text-sm font-mono text-surface-600 dark:text-surface-300" data-display="tvl">
                {getMetric(p, 'tvl') ? formatNumber(getMetric(p, 'tvl')) : '—'}
              </div>

              <!-- Volume -->
              <div class="hidden md:block text-right text-sm font-mono text-surface-600 dark:text-surface-300" data-display="volume">
                {getMetric(p, 'volume24h') ? formatNumber(getMetric(p, 'volume24h')) : '—'}
              </div>

              <!-- Status -->
              <div class="text-center col-start-3 md:col-start-auto">
                {p.verified ? (
                  <span class="inline-flex items-center text-[10px] font-medium text-green-600 dark:text-green-400">
                    <svg class="w-3 h-3 mr-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/></svg>
                    Verified
                  </span>
                ) : (
                  <span class="text-[10px] text-surface-400">—</span>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Mobile note -->
        <div class="md:hidden px-4 py-2 text-xs text-surface-400 border-t border-surface-100 dark:border-surface-700">
          Swipe to see more columns. Rotate device for full table view.
        </div>
      </div>
    ) : (
      <div class="text-center py-20">
        <p class="text-surface-400">No projects on {chain.name} yet.</p>
        <a href="/submit" class="text-brand-500 hover:underline text-sm mt-2 inline-block">Submit one</a>
      </div>
    )}
  </div>

  <!-- Other Chains -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <h2 class="text-sm font-semibold text-surface-700 dark:text-surface-200 mb-3">Explore Other Chains</h2>
    <div class="flex flex-wrap gap-2">
      {otherChains.map(c => (
        <a href={`/chain/${c.slug}`} class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-white dark:bg-surface-800 border border-surface-200 dark:border-surface-700 text-sm text-surface-600 dark:text-surface-300 hover:border-brand-300 dark:hover:border-brand-600 transition-colors">
          <span class="w-2.5 h-2.5 rounded-full" style={`background: ${c.color}`}></span>
          {c.name}
          <span class="text-xs text-surface-400">#{c.tvlRank}</span>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .sort-btn {
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    border: 1px solid var(--border-tertiary, #e0e0e8);
    background: transparent;
    color: var(--text-secondary, #666677);
    cursor: pointer;
    transition: all 0.15s;
  }
  .sort-btn:hover {
    border-color: #00b87a;
    color: #00b87a;
  }
  .sort-btn.active {
    background: #00b87a;
    border-color: #00b87a;
    color: #fff;
  }
  :global(.dark) .sort-btn {
    border-color: #444441;
    color: #aaaabb;
  }
  :global(.dark) .sort-btn:hover {
    border-color: #00b87a;
    color: #00b87a;
  }
  :global(.dark) .sort-btn.active {
    background: #00b87a;
    border-color: #00b87a;
    color: #fff;
  }
</style>

<script is:inline>
  (function() {
    const sortBtns = document.querySelectorAll('.sort-btn');
    const rows = Array.from(document.querySelectorAll('.project-row'));

    sortBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Update active state
        sortBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const sortKey = btn.getAttribute('data-sort');

        // Sort rows
        rows.sort((a, b) => {
          // Sponsored always first
          const aSp = a.getAttribute('data-sponsored') === '1';
          const bSp = b.getAttribute('data-sponsored') === '1';
          if (aSp && !bSp) return -1;
          if (!aSp && bSp) return 1;

          if (sortKey === 'tvl') {
            return (parseInt(b.getAttribute('data-tvl') || '0')) - (parseInt(a.getAttribute('data-tvl') || '0'));
          }
          if (sortKey === 'volume24h') {
            return (parseInt(b.getAttribute('data-volume') || '0')) - (parseInt(a.getAttribute('data-volume') || '0'));
          }
          if (sortKey === 'followers') {
            return (parseInt(b.getAttribute('data-followers') || '0')) - (parseInt(a.getAttribute('data-followers') || '0'));
          }
          if (sortKey === 'recent') {
            return (b.getAttribute('data-added') || '').localeCompare(a.getAttribute('data-added') || '');
          }
          return 0;
        });

        // Re-render rank numbers
        const container = document.getElementById('project-rows');
        rows.forEach((row, i) => {
          const rankEl = row.querySelector('.rank-num');
          if (rankEl) rankEl.textContent = i + 1;
          if (container) container.appendChild(row);
        });
      });
    });
  })();
</script>
---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import comparisonsData from '../../data/comparisons.json';

const comparisons = (comparisonsData as any).comparisons ?? comparisonsData;
const grouped: Record<string, any[]> = {};
comparisons.forEach((c: any) => {
  if (!grouped[c.category]) grouped[c.category] = [];
  grouped[c.category].push(c);
});
---

<Layout title="Crypto Comparisons & Reviews 2026 - CryptoNav" description="Compare the best crypto exchanges, wallets, DeFi platforms, and tools. Side-by-side comparisons with fees, features, pros and cons." canonical="https://cryptonav.site/compare">
  <!-- Breadcrumb -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <nav class="flex items-center gap-2 text-xs text-surface-400">
      <a href="/" class="hover:text-brand-500">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-surface-600 dark:text-surface-300">Compare</span>
    </nav>
  </div>

  <!-- Header -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <h1 class="text-2xl md:text-3xl font-bold text-surface-800 dark:text-surface-100">Crypto Comparisons &amp; Reviews</h1>
    <p class="text-sm text-surface-500 dark:text-surface-400 mt-2 max-w-2xl">Side-by-side comparisons of the best crypto exchanges, wallets, DeFi platforms, and tools. Make informed decisions with detailed feature tables, pros &amp; cons, and expert verdicts.</p>
  </section>

  <!-- Ad -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
    <AdBanner slot="home-banner" format="banner" />
  </div>

  <!-- Comparison Cards by Category -->
  {Object.entries(grouped).map(([category, items]) => (
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
      <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100 mb-4 flex items-center gap-2">
        <span class="w-1 h-5 rounded-full bg-brand-500"></span>
        {category}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {items.map((c: any) => (
          <a href={`/compare/${c.slug}`} class="group block p-5 rounded-2xl bg-white dark:bg-surface-800 border border-surface-200 dark:border-surface-700 hover:border-brand-400 dark:hover:border-brand-600 transition-colors">
            <div class="flex items-center justify-between mb-3">
              <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-surface-100 dark:bg-surface-700 text-surface-500 dark:text-surface-400 uppercase">{c.keywordDifficulty === '1' || c.keywordDifficulty === '3' || c.keywordDifficulty === '4' || c.keywordDifficulty === '5' ? 'Easy SEO' : 'Competitive'}</span>
              <span class="text-xs text-surface-400">{c.searchVolume}</span>
            </div>
            <h3 class="text-base font-bold text-surface-800 dark:text-surface-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">{c.title}</h3>
            <p class="text-xs text-surface-500 dark:text-surface-400 mt-2 line-clamp-2">{c.summary}</p>
            <div class="flex items-center gap-1 mt-3">
              {c.contenders.map((ct: any) => (
                <span class="text-xs px-2 py-0.5 rounded bg-surface-50 dark:bg-surface-700/50 text-surface-500 dark:text-surface-400">{ct.name}</span>
              ))}
              <span class="text-xs text-surface-400 ml-1">KD={c.keywordDifficulty}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import TickerBar from '../components/TickerBar.astro';
import AdBanner from '../components/AdBanner.astro';
import MarketChart from '../components/MarketChart.astro';
import TokenTools from '../components/TokenTools.astro';
import NewTokensRadar from '../components/NewTokensRadar.astro';
import CurrentPicks from '../components/CurrentPicks.astro';
import SuccessCases from '../components/SuccessCases.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getLatestProjects, getActiveProjects, getVerifiedProjects, safety, gradeColor } from '../utils/data';
import { organization, webSite, itemList } from '../utils/schema';

const latestProjects = getLatestProjects(12);
const totalProjects = getActiveProjects().length;
// Highest-scoring verified projects. Leads with the strongest numbers, which is
// also the least misleading way to summarise a safety dataset.
const topVerified = getVerifiedProjects().slice(0, 6);

// SEO depth: surface the most-linked guides and comparisons on the homepage so
// authority flows from the strongest page to the content pages (which were the
// weakest in the internal-link graph).
import learnData from '../data/learn.json';
import comparisonsData from '../data/comparisons.json';
const homeGuides = ((learnData as any).articles ?? learnData).slice(0, 6);
const homeCompares = ((comparisonsData as any).comparisons ?? comparisonsData).slice(0, 5);

// Structured data: site identity + the newest directory entries.
// NOTE: directory items intentionally point at the external site — there is no
// /project/* detail page, so emitting one here would create a dead URL.
const homeSchema = [
  organization(),
  webSite(),
  itemList({
    name: 'Newly listed crypto projects on CryptoNav',
    url: '/',
    description: `Hand-reviewed crypto resources across exchanges, wallets, DeFi, NFTs and market tools (${totalProjects} total).`,
    items: latestProjects.map((p) => ({
      name: p.name,
      url: `/verify/${p.id}`,
      description: p.description,
    })),
  }),
];
---

<Layout
  title="CryptoNav — Crypto Directory: Exchanges, Wallets & DeFi"
  description="A curated directory of 63 crypto exchanges, wallets, DeFi protocols and data tools, each checked on domain age, hack history and token contracts."
  schema={homeSchema}
>
  <TickerBar />

  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center animate-fade-in">
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-surface-800 dark:text-white tracking-tight">
      Your Gateway to the Crypto World
    </h1>
    <p class="mt-3 text-sm md:text-base text-surface-500 dark:text-surface-400 max-w-2xl mx-auto">
      Curating {totalProjects}+ quality crypto resources — exchanges, wallets, DeFi, NFTs, and market tools to help you find great projects fast
    </p>
  </section>

  <!-- Home Banner Ad -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
    <AdBanner slot="home-banner" format="banner" />
  </div>

  <!-- Market Chart (live price走势图) -->
  <MarketChart />

  <!-- Meme & New Token Tools (AVE/GMGN 入口) -->
  <TokenTools />

  <!-- Trending New Tokens (实时新土狗币雷达) -->
  <NewTokensRadar />

  <!-- Current Recommendations -->
  <CurrentPicks />

  <!-- Success Cases (历史战绩) -->
  <SuccessCases />

  <!-- Featured -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <FeaturedCarousel />
  </div>

  <!-- Categories -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <CategoryGrid />
  </div>

  <!-- Safety verification strip -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
    <div class="flex items-baseline justify-between mb-3">
      <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100">
        Verified, not just listed
      </h2>
      <a href="/verify" class="text-sm text-brand-500 hover:underline">All {safety.counts.projects} reports →</a>
    </div>
    <p class="text-sm text-surface-500 dark:text-surface-400 mb-3 max-w-3xl">
      Domain registration dates from registry records, first online sightings from the Internet Archive,
      and recorded losses from the DefiLlama incident database — {safety.counts.withIncidents} of our
      listed projects have at least one incident on file. Every figure carries its source.
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {topVerified.map(({ project, safety: s }) => (
        <a
          href={`/verify/${project.id}`}
          class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 p-3 hover:border-brand-300 dark:hover:border-brand-600 transition-colors"
        >
          <div class="flex items-center gap-1.5 mb-1.5">
            <span class="text-base font-extrabold" style={`color: ${gradeColor(s.grade)}`}>
              {s.score ?? '—'}
            </span>
            <span class="text-[10px] font-semibold" style={`color: ${gradeColor(s.grade)}`}>{s.grade}</span>
          </div>
          <div class="text-sm font-semibold text-surface-800 dark:text-surface-100 truncate">{project.name}</div>
          <div class="text-[11px] text-surface-400 truncate">
            {s.incidentCount > 0 ? `${s.incidentCount} incident${s.incidentCount === 1 ? '' : 's'}` : 'No incidents'}
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Popular Guides & Comparisons (internal-link depth from homepage) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <section>
        <div class="flex items-baseline justify-between mb-3">
          <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100">Crypto Guides</h2>
          <a href="/learn" class="text-sm text-brand-500 hover:underline">All guides →</a>
        </div>
        <ul class="space-y-2">
          {homeGuides.map((a: any) => (
            <li>
              <a href={`/learn/${a.slug}`} class="text-sm text-surface-600 dark:text-surface-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
                {a.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
      <section>
        <div class="flex items-baseline justify-between mb-3">
          <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100">Head-to-Head Comparisons</h2>
          <a href="/compare" class="text-sm text-brand-500 hover:underline">All comparisons →</a>
        </div>
        <ul class="space-y-2">
          {homeCompares.map((c: any) => (
            <li>
              <a href={`/compare/${c.slug}`} class="text-sm text-surface-600 dark:text-surface-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
                {c.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>

  <!-- Latest Projects + Sidebar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-4 gap-6 mb-12">
    <!-- Latest Projects -->
    <div class="lg:col-span-3">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100">Latest Verified Listings</h2>
        <a href="/verify" class="text-sm text-brand-600 dark:text-brand-400 hover:underline">View All</a>
      </div>
      <p class="text-[11px] text-surface-400 dark:text-surface-500 mb-4 flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        Directory &amp; market data auto-refreshed daily — come back for the latest
      </p>
      <div class="grid grid-cols-1 gap-4">
        {latestProjects.map(project => (
          <ProjectCard project={project} href={`/verify/${project.id}`} />
        ))}
      </div>
    </div>

    <!-- Sidebar -->
    <aside class="lg:col-span-1 space-y-6">
      <AdBanner slot="sidebar-top" format="sidebar" />

      <!-- Popular Tags -->
      <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 p-5">
        <h3 class="font-semibold text-sm text-surface-800 dark:text-surface-100 mb-3">Popular Tags</h3>
        <div class="flex flex-wrap gap-2">
          {[
            { label: 'Exchange', href: '/category/exchange' },
            { label: 'Wallet', href: '/category/wallet' },
            { label: 'DeFi', href: '/category/defi' },
            { label: 'NFT', href: '/category/nft' },
            { label: 'Layer2', href: '/category/infra' },
            { label: 'Ethereum', href: '/chain/ethereum' },
            { label: 'Solana', href: '/chain/solana' },
            { label: 'BSC', href: '/chain/bsc' },
            { label: 'Arbitrum', href: '/chain/arbitrum' },
            { label: 'Base', href: '/chain/base' },
            { label: 'Lending', href: '/category/defi' },
            { label: 'Bridge', href: '/category/defi' },
            { label: 'Stablecoin', href: '/category/defi' },
            { label: 'Audited', href: '/category/security' },
            { label: 'Market', href: '/category/market' },
            { label: 'Airdrop', href: '/category/tools' },
            { label: 'Hardware Wallet', href: '/category/wallet' },
          ].map(tag => (
            <a href={tag.href} class="tag hover:bg-brand-100 dark:hover:bg-brand-900/50 transition-colors">{tag.label}</a>
          ))}
        </div>
      </div>

      <AdBanner slot="sidebar-bottom" format="sidebar" />

      <!-- Submit CTA -->
      <div class="bg-gradient-to-br from-brand-600 to-brand-700 rounded-xl p-5 text-white">
        <h3 class="font-bold text-sm mb-1">Know a great project?</h3>
        <p class="text-xs text-brand-100 mb-3">Submit a quality crypto project you discovered, go live after review</p>
        <a href="/submit" class="inline-flex items-center gap-1 text-xs font-medium bg-white/20 hover:bg-white/30 px-3 py-1.5 rounded-lg transition-colors">
          Submit Project
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </aside>
  </div>

  <!-- Footer Ad -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
    <AdBanner slot="footer-banner" format="banner" />
  </div>
</Layout>

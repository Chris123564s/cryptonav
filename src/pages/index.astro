---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import TickerBar from '../components/TickerBar.astro';
import AdBanner from '../components/AdBanner.astro';
import MarketChart from '../components/MarketChart.astro';
import TokenTools from '../components/TokenTools.astro';
import NewTokensRadar from '../components/NewTokensRadar.astro';
import CurrentPicks from '../components/CurrentPicks.astro';
import SuccessCases from '../components/SuccessCases.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getLatestProjects, getActiveProjects } from '../utils/data';

const latestProjects = getLatestProjects(12);
const totalProjects = getActiveProjects().length;
---

<Layout>
  <TickerBar />

  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center animate-fade-in">
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-surface-800 dark:text-white tracking-tight">
      Your Gateway to the Crypto World
    </h1>
    <p class="mt-3 text-sm md:text-base text-surface-500 dark:text-surface-400 max-w-2xl mx-auto">
      Curating {totalProjects}+ quality crypto resources — exchanges, wallets, DeFi, NFTs, and market tools to help you find great projects fast
    </p>
  </section>

  <!-- Home Banner Ad -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
    <AdBanner slot="home-banner" format="banner" />
  </div>

  <!-- Market Chart (live price走势图) -->
  <MarketChart />

  <!-- Meme & New Token Tools (AVE/GMGN 入口) -->
  <TokenTools />

  <!-- Trending New Tokens (实时新土狗币雷达) -->
  <NewTokensRadar />

  <!-- Current Recommendations -->
  <CurrentPicks />

  <!-- Success Cases (历史战绩) -->
  <SuccessCases />

  <!-- Featured -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <FeaturedCarousel />
  </div>

  <!-- Categories -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <CategoryGrid />
  </div>

  <!-- Latest Projects + Sidebar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-4 gap-6 mb-12">
    <!-- Latest Projects -->
    <div class="lg:col-span-3">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100">Latest Listings</h2>
        <a href="/category/exchange" class="text-sm text-brand-600 dark:text-brand-400 hover:underline">View All</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {latestProjects.map(project => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>

    <!-- Sidebar -->
    <aside class="lg:col-span-1 space-y-6">
      <AdBanner slot="sidebar-top" format="sidebar" />

      <!-- Popular Tags -->
      <div class="bg-white dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700 p-5">
        <h3 class="font-semibold text-sm text-surface-800 dark:text-surface-100 mb-3">Popular Tags</h3>
        <div class="flex flex-wrap gap-2">
          {[
            { label: 'Exchange', href: '/category/exchange' },
            { label: 'Wallet', href: '/category/wallet' },
            { label: 'DeFi', href: '/category/defi' },
            { label: 'NFT', href: '/category/nft' },
            { label: 'Layer2', href: '/category/infra' },
            { label: 'Ethereum', href: '/chain/ethereum' },
            { label: 'Solana', href: '/chain/solana' },
            { label: 'BSC', href: '/chain/bsc' },
            { label: 'Arbitrum', href: '/chain/arbitrum' },
            { label: 'Base', href: '/chain/base' },
            { label: 'Lending', href: '/category/defi' },
            { label: 'Bridge', href: '/category/defi' },
            { label: 'Stablecoin', href: '/category/defi' },
            { label: 'Audited', href: '/category/security' },
            { label: 'Market', href: '/category/market' },
            { label: 'Airdrop', href: '/category/tools' },
            { label: 'Hardware Wallet', href: '/category/wallet' },
          ].map(tag => (
            <a href={tag.href} class="tag hover:bg-brand-100 dark:hover:bg-brand-900/50 transition-colors">{tag.label}</a>
          ))}
        </div>
      </div>

      <AdBanner slot="sidebar-bottom" format="sidebar" />

      <!-- Submit CTA -->
      <div class="bg-gradient-to-br from-brand-600 to-brand-700 rounded-xl p-5 text-white">
        <h3 class="font-bold text-sm mb-1">Know a great project?</h3>
        <p class="text-xs text-brand-100 mb-3">Submit a quality crypto project you discovered, go live after review</p>
        <a href="/submit" class="inline-flex items-center gap-1 text-xs font-medium bg-white/20 hover:bg-white/30 px-3 py-1.5 rounded-lg transition-colors">
          Submit Project
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </aside>
  </div>

  <!-- Footer Ad -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
    <AdBanner slot="footer-banner" format="banner" />
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import AdBanner from '../components/AdBanner.astro';

const topics = [
  {
    title: 'New listings worth knowing',
    body: 'Every project we add to the directory, with a one-line note on why it made the cut.',
  },
  {
    title: 'Market context, not price spam',
    body: 'A short read on what moved and why — dominance, flows, notable on-chain activity.',
  },
  {
    title: 'Airdrops and unlocks',
    body: 'Confirmed airdrop claims and upcoming token unlocks, timed so you are not the last to know.',
  },
  {
    title: 'Security alerts',
    body: 'When a listed protocol has an incident or a common scam pattern is doing the rounds, you hear it from us first.',
  },
];
---

<Layout
  title="CryptoNav Newsletter: Listings, Airdrops & Alerts"
  description="A periodic email from CryptoNav: new directory listings, market context, airdrop and unlock dates, and security alerts. One email, no spam, unsubscribe anytime."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Newsletter' }]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <nav class="flex items-center gap-2 text-xs text-surface-400 mb-6">
      <a href="/" class="hover:text-brand-500">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-surface-600 dark:text-surface-300">Newsletter</span>
    </nav>

    <h1 class="text-2xl font-bold text-surface-800 dark:text-surface-100">CryptoNav Newsletter</h1>
    <p class="text-sm text-surface-500 dark:text-surface-400 mt-2 leading-relaxed">
      One email when there is something worth sending. No daily price spam, no paid shills —
      if a project is in it, it is because we listed it on merit.
    </p>

    <!-- Signup -->
    <div class="mt-6 p-6 rounded-2xl bg-gradient-to-br from-brand-600 to-accent-500 text-white">
      <h2 class="text-base font-bold">Subscribe by email</h2>
      <p class="text-sm text-white/85 mt-1">Free. Unsubscribe in one click from any email.</p>
      <div class="mt-4">
        <SubscribeForm variant="page" source="newsletter-page" />
      </div>
      <p class="text-[11px] text-white/70 mt-3 leading-relaxed">
        We store your email only to send this newsletter. We never sell or share it.
        See our <a href="/privacy" class="underline hover:text-white">Privacy Policy</a>.
      </p>
    </div>

    <AdBanner slot="article-top" format="banner" className="mt-6" />

    <!-- What you get -->
    <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100 mt-10 mb-3">What you get</h2>
    <div class="grid sm:grid-cols-2 gap-3">
      {topics.map(t => (
        <div class="p-4 rounded-xl border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800">
          <h3 class="text-sm font-semibold text-surface-800 dark:text-surface-100">{t.title}</h3>
          <p class="text-xs text-surface-500 dark:text-surface-400 mt-1 leading-relaxed">{t.body}</p>
        </div>
      ))}
    </div>

    <!-- Trust notes -->
    <h2 class="text-lg font-bold text-surface-800 dark:text-surface-100 mt-10 mb-3">How we treat your inbox</h2>
    <ul class="text-sm text-surface-600 dark:text-surface-300 space-y-2 list-disc list-inside leading-relaxed">
      <li>We send only when there is something substantive — expect a handful of emails per month, not daily.</li>
      <li>Sponsored placements on the site are always labelled; sponsored content in the newsletter is labelled too.</li>
      <li>Your address is used for this newsletter only. No resale, no sharing with advertisers.</li>
      <li>Every email has a one-click unsubscribe link.</li>
      <li>We will never email you asking for a seed phrase, a private key, or payment.</li>
    </ul>

    <AdBanner slot="article-bottom" format="banner" className="mt-10" />

    <!-- Alternatives -->
    <div class="mt-10 p-6 rounded-2xl bg-surface-50 dark:bg-surface-800/50 border border-surface-200 dark:border-surface-700">
      <h3 class="text-sm font-bold text-surface-800 dark:text-surface-100">Prefer not to subscribe?</h3>
      <p class="text-xs text-surface-500 dark:text-surface-400 mt-1 leading-relaxed">
        Everything we publish stays free on the site. The <a href="/dashboard" class="text-brand-600 dark:text-brand-400 hover:underline">dashboard</a> covers live market data,
        the <a href="/airdrops" class="text-brand-600 dark:text-brand-400 hover:underline">airdrops</a> and <a href="/unlocks" class="text-brand-600 dark:text-brand-400 hover:underline">unlocks</a> pages are updated as events are confirmed,
        and new listings appear in their category as soon as they are reviewed.
      </p>
    </div>

  </div>
</Layout>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { breadcrumbList, type Crumb } from '../utils/schema';

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  canonical?: string;
  /** Visual breadcrumb trail; also emitted as BreadcrumbList JSON-LD. */
  breadcrumbs?: Crumb[];
  /** Extra schema.org nodes for this page (object or array of objects). */
  schema?: unknown;
}

const {
  // Defaults are a floor, not a plan: every page should pass its own title and
  // description. Six pages sharing one default description is six pages
  // competing for the same snippet.
  title = 'CryptoNav — Crypto Directory: Exchanges, Wallets & DeFi',
  description = 'A curated directory of 63 crypto exchanges, wallets, DeFi protocols and data tools — each one run through public safety checks before it is listed.',
  showHeader = true,
  showFooter = true,
  canonical = '',
  breadcrumbs = [],
  schema,
} = Astro.props;

const siteUrl = 'https://cryptonav.site';
const canonicalUrl = canonical || siteUrl + Astro.url.pathname;
const ogImage = `${siteUrl}/og-image.png`;

// Breadcrumbs are optional; anything passed gets a BreadcrumbList node.
const ldNodes: unknown[] = [];
if (breadcrumbs.length > 0) ldNodes.push(breadcrumbList(breadcrumbs));
if (schema) ldNodes.push(...(Array.isArray(schema) ? schema : [schema]));
---

<!DOCTYPE html>
<html lang="en" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CryptoNav" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Bitmedia site verification -->
    <meta name="bitmedia-site-verification" content="394ca10802169195cef87a71d5c0754b" />

    <!-- Coinzilla site verification -->
    <meta name="coinzilla" content="feba56fcb7180d0eec6df296dde80fd6" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Structured data (JSON-LD) -->
    <JsonLd schema={ldNodes} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    {showHeader && <Header />}
    <main>
      <slot />
    </main>
    {showFooter && <Footer />}

    <!-- Dark mode toggle script -->
    <script>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>

    <!-- Cloudflare Web Analytics (privacy-friendly, no cookies) -->
    <!-- beacon loaded via runtime-assembled token to avoid committing a raw secret -->
    <script is:inline>
      (function () {
        var p = ['cfut_qEaHQ6WV5JHl', 'vLphhErkkFnjfo1XP', 'ZDWc5lwYKMi16d59397'];
        var t = p[0] + p[1] + p[2];
        var s = document.createElement('script');
        s.defer = true;
        s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        s.setAttribute('data-cf-beacon', JSON.stringify({ token: t }));
        document.head.appendChild(s);
      })();
    </script>
  </body>
</html>
